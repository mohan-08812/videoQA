{\b\f0\fs28 upload_to_hf.py\par}
{\f1\fs20 import os\par
from dotenv import load_dotenv\par
from huggingface_hub import HfApi\par
\par
# Load environment variables\par
load_dotenv("backend/.env")\par
\par
# Get token\par
token = os.getenv("HF_TOKEN")\par
if not token:\par
    print("ERROR: HF_TOKEN not found! Please save your backend/.env file.")\par
    exit(1)\par
\par
api = HfApi(token=token)\par
repo_id = "mohanvannemreddy7/genvideoai"\par
\par
print(f"Uploading all files to: https://huggingface.co/spaces/\{repo_id\}...")\par
\par
# Upload the current folder, replacing remote files but ignoring git, venv, and cache\par
api.upload_folder(\par
    folder_path=".",\par
    repo_id=repo_id,\par
    repo_type="space",\par
    delete_patterns="*",  # This ensures any remote files not present locally are deleted\par
    ignore_patterns=[\par
        ".git/*",\par
        "backend/venv/*",\par
        "backend/__pycache__/*",\par
        "backend/outputs/*",\par
        "backend/uploads/*",\par
        "upload_to_hf.py", # Exclude this script itself\par
        "backend/cookies.txt", # Don't push private cookies\par
        "backend/.env" # SECRETS: Exclude environment variables\par
    ]\par
)\par
\par
print("Upload complete!")\par
\par\par}

