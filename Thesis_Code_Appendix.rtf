{\f1\fs20 <!DOCTYPE html>\par
<html lang="en" data-theme="dark">\par
\par
<head>\par
  <meta charset="UTF-8" />\par
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />\par
  <title>VideoQA – Multimodal Video Question Answering</title>\par
  <meta name="description"\par
    content="Ask questions about any video using AI-powered audio transcription, vision captions, and LLM reasoning." />\par
  <link rel="stylesheet" href="style.css" />\par
  <link rel="icon"\par
    href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎬</text></svg>" />\par
</head>\par
\par
<body>\par
\par
  <!-- ── Background Orbs ─────────────────────────────────── -->\par
  <div class="bg-orbs" aria-hidden="true">\par
    <div class="orb orb-1"></div>\par
    <div class="orb orb-2"></div>\par
    <div class="orb orb-3"></div>\par
  </div>\par
\par
  <!-- ── App Root ────────────────────────────────────────── -->\par
  <div id="app">\par
\par
    <!-- ════════════════════════════════════════\par
         HEADER\par
    ════════════════════════════════════════ -->\par
    <header class="header" role="banner">\par
\par
      <!-- Logo -->\par
      <a href="javascript:void(0)" class="header-logo" aria-label="VideoQA Home">\par
        <div class="logo-icon" aria-hidden="true">🎬</div>\par
        <span class="logo-text">VideoQA</span>\par
      </a>\par
\par
      <!-- Tab navigation -->\par
      <nav class="header-tabs" role="tablist" aria-label="Main navigation">\par
        <button class="tab-btn active" id="tab-ask" data-tab="ask" role="tab" type="button" aria-selected="true"\par
          aria-controls="panel-ask" tabindex="0">\par
          💬 Ask\par
        </button>\par
\par
        <button class="tab-btn" id="tab-summarize" data-tab="summarize" role="tab" type="button" aria-selected="false"\par
          aria-controls="panel-summarize" tabindex="-1">\par
          📊 Summarize\par
        </button>\par
\par
        <button class="tab-btn" id="tab-transcript" data-tab="transcript" role="tab" type="button" aria-selected="false"\par
          aria-controls="panel-transcript" tabindex="-1">\par
          📄 Transcript\par
        </button>\par
      </nav>\par
\par
      <!-- Action buttons -->\par
      <div class="header-actions">\par
        <button class="btn-ghost" id="how-btn" type="button" aria-label="How it works">\par
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"\par
            aria-hidden="true">\par
            <circle cx="12" cy="12" r="10" />\par
            <path d="M12 16v-4M12 8h.01" />\par
          </svg>\par
          <span>How it works</span>\par
        </button>\par
\par
        <button class="btn-ghost" id="clear-btn" type="button" aria-label="Clear session">\par
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"\par
            aria-hidden="true">\par
            <path d="M3 6h18M19 6l-1 14H6L5 6M10 11v6M14 11v6M9 6V4h6v2" />\par
          </svg>\par
          <span>Clear</span>\par
        </button>\par
\par
        <!-- Mobile history drawer toggle -->\par
        <button class="btn-icon history-btn-mobile" id="history-mobile-btn" type="button" aria-label="View history">\par
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"\par
            aria-hidden="true">\par
            <path d="M12 8v4l3 3M3.05 11a9 9 0 1 0 .5-3" />\par
            <path d="M3 4v4h4" />\par
          </svg>\par
        </button>\par
\par
        <button class="btn-icon" id="theme-toggle" type="button" aria-label="Toggle theme">☀️</button>\par
      </div>\par
    </header>\par
\par
    <!-- ════════════════════════════════════════\par
         HERO\par
    ════════════════════════════════════════ -->\par
    <section class="hero" aria-labelledby="hero-title">\par
      <div class="hero-badge">\par
        <span class="dot" aria-hidden="true"></span>\par
        AI-Powered · Multimodal\par
      </div>\par
      <h1 id="hero-title">Ask any question about your video</h1>\par
      <p>Powered by audio transcription + vision captions + LLM reasoning</p>\par
\par
      <div class="feature-chips" role="list" aria-label="Features">\par
        <span class="chip" role="listitem"><span class="ci">⚡</span> Fast</span>\par
        <span class="chip" role="listitem"><span class="ci">🌍</span> Multilingual</span>\par
        <span class="chip" role="listitem"><span class="ci">✂️</span> Clip Retrieval</span>\par
        <span class="chip" role="listitem"><span class="ci">📝</span> Summaries</span>\par
        <span class="chip" role="listitem"><span class="ci">📄</span> Transcript Viewer</span>\par
      </div>\par
    </section>\par
\par
    <!-- ════════════════════════════════════════\par
         UPLOAD PANEL (full width)\par
    ════════════════════════════════════════ -->\par
    <div style="padding: 0 var(--space-6); max-width:1300px; margin:0 auto; width:100%;">\par
      <div class="glass upload-panel">\par
\par
        <!-- Drop zone -->\par
        <div class="drop-zone" id="drop-zone" role="button" tabindex="0"\par
          aria-label="Click or drag to upload a video file">\par
          <input type="file" id="file-input"\par
            accept="video/mp4,video/quicktime,video/x-matroska,video/webm,.mp4,.mov,.mkv,.webm"\par
            aria-label="Upload video file" />\par
          <span class="drop-icon" aria-hidden="true">📁</span>\par
          <h3>Drop your video here or click to upload</h3>\par
          <p>Supported formats: MP4, MOV, MKV, WebM</p>\par
          <div class="drop-formats" aria-label="Supported formats">\par
            <span class="fmt-badge">.mp4</span>\par
            <span class="fmt-badge">.mov</span>\par
            <span class="fmt-badge">.mkv</span>\par
            <span class="fmt-badge">.webm</span>\par
          </div>\par
          <div class="or-divider" style="margin: 20px 0; font-size: 14px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">— OR —</div>\par
          <div class="url-upload" style="display: flex; gap: 8px; width: 80%; max-width: 400px; margin: 0 auto;" onclick="event.stopPropagation()">\par
            <input type="url" id="url-input" class="select-styled" placeholder="Paste video URL (YouTube, direct links, etc.)" style="width: 100%; flex: 1; min-width: 0;" aria-label="Video URL">\par
            <button class="btn-secondary" id="add-url-btn" type="button" style="white-space: nowrap;">Add URL</button>\par
          </div>\par
        </div>\par
\par
        <!-- File info -->\par
        <div class="file-info" id="file-info" role="status" aria-live="polite">\par
          <span class="file-icon" aria-hidden="true">🎥</span>\par
          <div class="file-meta">\par
            <div class="file-name" id="file-name-display">—</div>\par
            <div class="file-detail" id="file-detail-display">—</div>\par
          </div>\par
          <button class="file-remove" id="file-remove" type="button" aria-label="Remove file">✕</button>\par
        </div>\par
\par
        <!-- Video preview -->\par
        <div class="video-preview-wrap" id="video-preview-wrap">\par
          <video id="video-preview" controls preload="metadata" aria-label="Video preview"></video>\par
          \par
          <!-- Manual Selection Tools -->\par
          <div class="manual-selection-tools" id="manual-selection-tools" style="display: none; flex-direction: column; gap: 10px; margin-top: 15px; padding: 15px; background: rgba(255,255,255,0.05); border-radius: 8px;">\par
            <div style="display: flex; gap: 15px; flex-wrap: wrap; align-items: center;">\par
              <div class="form-group" style="margin: 0; flex: 1; min-width: 120px;">\par
                <label class="form-label" for="manual-start">Start Time (sec)</label>\par
                <input type="number" id="manual-start" class="select-styled" placeholder="0" min="0" step="0.1" style="width: 100%;">\par
              </div>\par
              <div class="form-group" style="margin: 0; flex: 1; min-width: 120px;">\par
                <label class="form-label" for="manual-end">End Time (sec)</label>\par
                <input type="number" id="manual-end" class="select-styled" placeholder="All" min="0" step="0.1" style="width: 100%;">\par
              </div>\par
              <button class="btn-secondary" id="add-frame-btn" type="button" style="margin-top: 24px; white-space: nowrap;">📸 Add Current Frame</button>\par
            </div>\par
            <div id="manual-frames-list" style="display: flex; gap: 8px; flex-wrap: wrap;"></div>\par
            <p style="font-size: 12px; color: var(--text-muted); margin: 0;">Optional: Specify a start/end time to process a sub-clip, and manually pick keyframes. Leave blank to process the whole video automatically.</p>\par
          </div>\par
        </div>\par
\par
        <!-- Controls -->\par
        <div class="upload-controls">\par
          <div class="form-group">\par
            <label class="form-label" for="language-select">Language</label>\par
            <select class="select-styled" id="language-select" aria-label="Select language">\par
              <optgroup label="🌍 World Languages">\par
                <option value="en">English</option>\par
                <option value="es">Spanish</option>\par
                <option value="fr">French</option>\par
                <option value="de">German</option>\par
                <option value="zh">Chinese</option>\par
                <option value="ar">Arabic</option>\par
                <option value="ja">Japanese</option>\par
                <option value="ko">Korean</option>\par
                <option value="pt">Portuguese</option>\par
                <option value="ru">Russian</option>\par
                <option value="it">Italian</option>\par
              </optgroup>\par
              <optgroup label="🇮🇳 Indian Languages">\par
                <option value="hi">Hindi (हिन्दी)</option>\par
                <option value="te">Telugu (తెలుగు)</option>\par
                <option value="ta">Tamil (தமிழ்)</option>\par
                <option value="kn">Kannada (ಕನ್ನಡ)</option>\par
                <option value="ml">Malayalam (മലയാളം)</option>\par
                <option value="mr">Marathi (मराठी)</option>\par
                <option value="bn">Bengali (বাংলা)</option>\par
                <option value="pa">Punjabi (ਪੰਜਾਬੀ)</option>\par
                <option value="gu">Gujarati (ગુજરાતી)</option>\par
                <option value="ur">Urdu (اردو)</option>\par
              </optgroup>\par
            </select>\par
          </div>\par
\par
          <div class="form-group">\par
            <label class="form-label">Processing Mode</label>\par
            <div class="mode-toggle" role="group" aria-label="Processing mode">\par
              <button class="mode-opt active" data-mode="fast" type="button" aria-pressed="true">⚡ Fast QA</button>\par
              <button class="mode-opt" data-mode="full" type="button" aria-pressed="false">🔬 QA + Clip\par
                Retrieval</button>\par
            </div>\par
          </div>\par
\par
          <button class="btn-primary" id="process-btn" type="button" disabled aria-label="Process video">\par
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"\par
              aria-hidden="true">\par
              <polygon points="5 3 19 12 5 21 5 3" />\par
            </svg>\par
            Process Video\par
          </button>\par
        </div>\par
\par
        <!-- Progress Timeline -->\par
        <div class="progress-panel" id="progress-panel" role="status" aria-live="polite"\par
          aria-label="Processing progress">\par
          <div class="progress-header">\par
            <span class="progress-title" id="progress-status">Starting…</span>\par
            <span class="progress-pct" id="progress-pct">0%</span>\par
          </div>\par
          <div class="progress-bar-outer" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">\par
            <div class="progress-bar-inner" id="progress-bar"></div>\par
          </div>\par
          <div class="progress-steps" id="progress-steps">\par
            <!-- Populated by JS -->\par
          </div>\par
        </div>\par
\par
      </div>\par
    </div>\par
\par
    <!-- ════════════════════════════════════════\par
         MAIN LAYOUT (Content + Sidebar)\par
    ════════════════════════════════════════ -->\par
    <div class="main-layout">\par
\par
      <!-- CONTENT AREA -->\par
      <main class="content-area" role="main">\par
\par
        <!-- ── ASK TAB ───────────────────────────── -->\par
        <section class="tab-panel active" id="panel-ask" role="tabpanel" aria-labelledby="tab-ask">\par
          <div id="ask-content">\par
            <!-- Populated by JS (demo state → ready state after processing) -->\par
          </div>\par
        </section>\par
\par
        <!-- ── SUMMARIZE TAB ─────────────────────── -->\par
        <section class="tab-panel" id="panel-summarize" role="tabpanel" aria-labelledby="tab-summarize" hidden>\par
          <div id="summarize-content">\par
            <!-- Populated by JS -->\par
          </div>\par
        </section>\par
\par
        <!-- ── TRANSCRIPT TAB ────────────────────── -->\par
        <section class="tab-panel" id="panel-transcript" role="tabpanel" aria-labelledby="tab-transcript" hidden>\par
          <div id="transcript-content" style="overflow:hidden; border-radius:var(--radius-lg);" class="glass">\par
            <!-- Populated by JS -->\par
          </div>\par
        </section>\par
\par
      </main>\par
\par
      <!-- HISTORY SIDEBAR -->\par
      <aside class="sidebar" id="sidebar" aria-label="Q&A History">\par
        <div class="glass history-card">\par
          <div class="history-header">\par
            <h3>🕐 History</h3>\par
            <span class="history-count" id="history-count">0</span>\par
          </div>\par
          <div class="history-list" id="history-list" role="list">\par
            <div class="history-empty">No questions yet.<br>Ask something to get started.</div>\par
          </div>\par
        </div>\par
      </aside>\par
\par
    </div>\par
\par
    <!-- ════════════════════════════════════════\par
         "HOW IT WORKS" MODAL\par
    ════════════════════════════════════════ -->\par
    <div class="modal-overlay" id="how-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" hidden>\par
      <div class="glass modal-box">\par
        <div class="modal-header">\par
          <h2 id="modal-title">How VideoQA Works</h2>\par
          <button class="modal-close" id="modal-close" type="button" aria-label="Close modal">✕</button>\par
        </div>\par
\par
        <div class="how-steps">\par
          <div class="how-step">\par
            <div class="how-num">1</div>\par
            <div>\par
              <h4>📁 Upload Your Video</h4>\par
              <p>Drag and drop any MP4, MOV, or MKV video. Select your language for accurate transcription.</p>\par
            </div>\par
          </div>\par
\par
          <div class="how-step">\par
            <div class="how-num">2</div>\par
            <div>\par
              <h4>🔊 Audio Transcription</h4>\par
              <p>The audio is extracted and transcribed using Whisper — a state-of-the-art multilingual speech\par
                recognition model.</p>\par
            </div>\par
          </div>\par
\par
          <div class="how-step">\par
            <div class="how-num">3</div>\par
            <div>\par
              <h4>👁️ Visual Understanding</h4>\par
              <p>Key frames are extracted and described using vision models, capturing what's shown on screen.</p>\par
            </div>\par
          </div>\par
\par
          <div class="how-step">\par
            <div class="how-num">4</div>\par
            <div>\par
              <h4>🧠 LLM Reasoning</h4>\par
              <p>Your question is answered by an LLM with full context of the transcript + visual captions, finding the\par
                most relevant clip.</p>\par
            </div>\par
          </div>\par
\par
          <div class="how-step">\par
            <div class="how-num">5</div>\par
            <div>\par
              <h4>📊 Summaries & Insights</h4>\par
              <p>Get video summaries, transcript key points, action items, and keywords — all AI-generated instantly.\par
              </p>\par
            </div>\par
          </div>\par
        </div>\par
      </div>\par
    </div>\par
\par
    <!-- ════════════════════════════════════════\par
         FOOTER\par
    ════════════════════════════════════════ -->\par
    <footer class="footer">\par
      <p>\par
        VideoQA · Multimodal AI · Built with 🧠 &amp; ☕ ·\par
        <a href="javascript:void(0)" aria-label="View project on GitHub">View on GitHub</a>\par
      </p>\par
    </footer>\par
\par
  </div>\par
\par
  <!-- ── Toast Container ─────────────────────────────────── -->\par
  <div class="toast-container" id="toast-container" aria-live="assertive" aria-atomic="true"></div>\par
\par
  <!-- ── Scripts ─────────────────────────────────────────── -->\par
  <script src="mock.js"></script>\par
  <script src="api.js"></script>\par
  <script src="app.js"></script>\par
\par
</body>\par
\par
</html>\par\par}

