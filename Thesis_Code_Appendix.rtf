{\f1\fs20 /* =========================================================\par
   VideoQA – Premium Design System CSS\par
   Dark-first, glassmorphism, responsive, animated\par
   ========================================================= */\par
\par
/* ── Google Fonts ──────────────────────────────────────── */\par
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');\par
\par
/* ── CSS Custom Properties ─────────────────────────────── */\par
:root \{\par
  /* Spacing */\par
  --space-1: 4px;\par
  --space-2: 8px;\par
  --space-3: 12px;\par
  --space-4: 16px;\par
  --space-5: 20px;\par
  --space-6: 24px;\par
  --space-8: 32px;\par
  --space-10: 40px;\par
  --space-12: 48px;\par
\par
  /* Radius */\par
  --radius-sm: 8px;\par
  --radius-md: 14px;\par
  --radius-lg: 20px;\par
  --radius-xl: 28px;\par
\par
  /* Transitions */\par
  --ease: cubic-bezier(0.4, 0, 0.2, 1);\par
  --transition: 0.22s var(--ease);\par
  --transition-slow: 0.45s var(--ease);\par
\par
  /* Typography */\par
  --font-sans: 'Inter', system-ui, sans-serif;\par
  --font-mono: 'JetBrains Mono', 'Fira Code', monospace;\par
\par
  /* Shadows */\par
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.25);\par
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.35);\par
  --shadow-lg: 0 20px 48px rgba(0, 0, 0, 0.4);\par
  --shadow-glow: 0 0 32px rgba(102, 126, 234, 0.3);\par
\}\par
\par
/* ── Dark Theme (default) ──────────────────────────────── */\par
[data-theme="dark"] \{\par
  --bg-base: #0b0e1a;\par
  --bg-surface: #111425;\par
  --bg-card: rgba(20, 25, 50, 0.7);\par
  --bg-card-hover: rgba(30, 37, 70, 0.85);\par
  --bg-input: rgba(15, 20, 42, 0.8);\par
  --bg-chip: rgba(102, 126, 234, 0.15);\par
  --border: rgba(255, 255, 255, 0.08);\par
  --border-accent: rgba(102, 126, 234, 0.4);\par
\par
  --text-primary: #f0f2ff;\par
  --text-secondary: #8b91b8;\par
  --text-muted: #555c80;\par
  --text-accent: #818cf8;\par
\par
  --accent: #667eea;\par
  --accent-2: #764ba2;\par
  --accent-light: #a5b4fc;\par
  --success: #34d399;\par
  --warning: #fbbf24;\par
  --error: #f87171;\par
\par
  --gradient-bg: linear-gradient(135deg, #0b0e1a 0%, #0f1229 40%, #13112a 70%, #0b0e1a 100%);\par
  --gradient-accent: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\par
  --gradient-card: linear-gradient(145deg, rgba(30, 37, 80, 0.5) 0%, rgba(15, 18, 45, 0.5) 100%);\par
\par
  --glass-bg: rgba(15, 18, 40, 0.65);\par
  --glass-border: rgba(255, 255, 255, 0.08);\par
  --glass-blur: blur(20px);\par
\}\par
\par
/* ── Light Theme ───────────────────────────────────────── */\par
[data-theme="light"] \{\par
  --bg-base: #f0f2ff;\par
  --bg-surface: #ffffff;\par
  --bg-card: rgba(255, 255, 255, 0.85);\par
  --bg-card-hover: rgba(245, 247, 255, 0.95);\par
  --bg-input: rgba(245, 247, 255, 0.9);\par
  --bg-chip: rgba(102, 126, 234, 0.1);\par
  --border: rgba(0, 0, 0, 0.08);\par
  --border-accent: rgba(102, 126, 234, 0.35);\par
\par
  --text-primary: #1a1d35;\par
  --text-secondary: #4b5080;\par
  --text-muted: #9098c0;\par
  --text-accent: #5b6ee8;\par
\par
  --accent: #667eea;\par
  --accent-2: #764ba2;\par
  --accent-light: #818cf8;\par
  --success: #059669;\par
  --warning: #d97706;\par
  --error: #dc2626;\par
\par
  --gradient-bg: linear-gradient(135deg, #eef0fc 0%, #f5f0ff 50%, #edf2ff 100%);\par
  --gradient-accent: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\par
  --gradient-card: linear-gradient(145deg, rgba(255, 255, 255, 0.9) 0%, rgba(240, 242, 255, 0.8) 100%);\par
\par
  --glass-bg: rgba(255, 255, 255, 0.75);\par
  --glass-border: rgba(102, 126, 234, 0.15);\par
  --glass-blur: blur(16px);\par
\}\par
\par
/* ── Reset & Base ──────────────────────────────────────── */\par
*,\par
*::before,\par
*::after \{\par
  box-sizing: border-box;\par
  margin: 0;\par
  padding: 0;\par
\}\par
\par
html \{\par
  scroll-behavior: smooth;\par
\}\par
\par
body \{\par
  font-family: var(--font-sans);\par
  background: var(--gradient-bg);\par
  background-attachment: fixed;\par
  color: var(--text-primary);\par
  min-height: 100vh;\par
  line-height: 1.6;\par
  transition: background var(--transition-slow), color var(--transition);\par
  overflow-x: hidden;\par
\}\par
\par
/* ── Animated Background Orbs ──────────────────────────── */\par
.bg-orbs \{\par
  position: fixed;\par
  inset: 0;\par
  pointer-events: none;\par
  z-index: 0;\par
  overflow: hidden;\par
\}\par
\par
.orb \{\par
  position: absolute;\par
  border-radius: 50%;\par
  filter: blur(80px);\par
  opacity: 0.18;\par
  animation: orbFloat 12s ease-in-out infinite;\par
\}\par
\par
.orb-1 \{\par
  width: 600px;\par
  height: 600px;\par
  background: radial-gradient(circle, #667eea, transparent);\par
  top: -200px;\par
  left: -150px;\par
  animation-delay: 0s;\par
\}\par
\par
.orb-2 \{\par
  width: 500px;\par
  height: 500px;\par
  background: radial-gradient(circle, #764ba2, transparent);\par
  bottom: -150px;\par
  right: -100px;\par
  animation-delay: -4s;\par
\}\par
\par
.orb-3 \{\par
  width: 400px;\par
  height: 400px;\par
  background: radial-gradient(circle, #06b6d4, transparent);\par
  top: 40%;\par
  right: 20%;\par
  animation-delay: -8s;\par
\}\par
\par
@keyframes orbFloat \{\par
\par
  0%,\par
  100% \{\par
    transform: translate(0, 0) scale(1);\par
  \}\par
\par
  33% \{\par
    transform: translate(30px, -20px) scale(1.05);\par
  \}\par
\par
  66% \{\par
    transform: translate(-20px, 30px) scale(0.95);\par
  \}\par
\}\par
\par
/* ── Glass Card Utility ────────────────────────────────── */\par
.glass \{\par
  background: var(--glass-bg);\par
  backdrop-filter: var(--glass-blur);\par
  -webkit-backdrop-filter: var(--glass-blur);\par
  border: 1px solid var(--glass-border);\par
  border-radius: var(--radius-lg);\par
\}\par
\par
.glass-sm \{\par
  border-radius: var(--radius-md);\par
\}\par
\par
/* ── Scrollbar ─────────────────────────────────────────── */\par
::-webkit-scrollbar \{\par
  width: 6px;\par
  height: 6px;\par
\}\par
\par
::-webkit-scrollbar-track \{\par
  background: transparent;\par
\}\par
\par
::-webkit-scrollbar-thumb \{\par
  background: var(--border-accent);\par
  border-radius: 99px;\par
\}\par
\par
/* ── Layout Container ──────────────────────────────────── */\par
#app \{\par
  position: relative;\par
  z-index: 1;\par
  min-height: 100vh;\par
  display: flex;\par
  flex-direction: column;\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   HEADER\par
═══════════════════════════════════════════ */\par
.header \{\par
  position: sticky;\par
  top: 0;\par
  z-index: 100;\par
  background: var(--glass-bg);\par
  backdrop-filter: var(--glass-blur);\par
  -webkit-backdrop-filter: var(--glass-blur);\par
  border-bottom: 1px solid var(--glass-border);\par
  padding: 0 var(--space-6);\par
  height: 64px;\par
  display: flex;\par
  align-items: center;\par
  justify-content: space-between;\par
  gap: var(--space-4);\par
  transition: background var(--transition);\par
\}\par
\par
.header-logo \{\par
  display: flex;\par
  align-items: center;\par
  gap: var(--space-3);\par
  text-decoration: none;\par
  flex-shrink: 0;\par
\}\par
\par
.logo-icon \{\par
  width: 38px;\par
  height: 38px;\par
  background: var(--gradient-accent);\par
  border-radius: var(--radius-sm);\par
  display: flex;\par
  align-items: center;\par
  justify-content: center;\par
  font-size: 18px;\par
  box-shadow: var(--shadow-glow);\par
\}\par
\par
.logo-text \{\par
  font-size: 18px;\par
  font-weight: 800;\par
  background: var(--gradient-accent);\par
  -webkit-background-clip: text;\par
  -webkit-text-fill-color: transparent;\par
  background-clip: text;\par
  letter-spacing: -0.5px;\par
\}\par
\par
/* Tab bar inside header */\par
.header-tabs \{\par
  display: flex;\par
  align-items: center;\par
  gap: var(--space-1);\par
  background: rgba(0, 0, 0, 0.25);\par
  border: 1px solid var(--border);\par
  border-radius: var(--radius-xl);\par
  padding: 4px;\par
  flex-shrink: 0;\par
\}\par
\par
[data-theme="light"] .header-tabs \{\par
  background: rgba(102, 126, 234, 0.08);\par
\}\par
\par
.tab-btn \{\par
  padding: 6px 18px;\par
  border: none;\par
  background: none;\par
  cursor: pointer;\par
  color: var(--text-secondary);\par
  font-size: 13px;\par
  font-weight: 600;\par
  font-family: var(--font-sans);\par
  border-radius: 20px;\par
  transition: all var(--transition);\par
  white-space: nowrap;\par
\}\par
\par
.tab-btn:hover \{\par
  color: var(--text-primary);\par
  background: rgba(255, 255, 255, 0.06);\par
\}\par
\par
.tab-btn.active \{\par
  background: var(--gradient-accent);\par
  color: #fff;\par
  box-shadow: 0 2px 12px rgba(102, 126, 234, 0.4);\par
\}\par
\par
/* Header actions */\par
.header-actions \{\par
  display: flex;\par
  align-items: center;\par
  gap: var(--space-2);\par
  flex-shrink: 0;\par
\}\par
\par
.btn-ghost \{\par
  padding: 7px 14px;\par
  background: none;\par
  border: 1px solid var(--border);\par
  color: var(--text-secondary);\par
  border-radius: var(--radius-sm);\par
  font-size: 13px;\par
  font-weight: 500;\par
  font-family: var(--font-sans);\par
  cursor: pointer;\par
  transition: all var(--transition);\par
  display: flex;\par
  align-items: center;\par
  gap: var(--space-2);\par
\}\par
\par
.btn-ghost:hover \{\par
  border-color: var(--border-accent);\par
  color: var(--text-primary);\par
  background: rgba(102, 126, 234, 0.1);\par
\}\par
\par
.btn-icon \{\par
  width: 36px;\par
  height: 36px;\par
  background: none;\par
  border: 1px solid var(--border);\par
  color: var(--text-secondary);\par
  border-radius: var(--radius-sm);\par
  cursor: pointer;\par
  transition: all var(--transition);\par
  display: flex;\par
  align-items: center;\par
  justify-content: center;\par
  font-size: 16px;\par
\}\par
\par
.btn-icon:hover \{\par
  border-color: var(--border-accent);\par
  color: var(--text-primary);\par
  background: rgba(102, 126, 234, 0.1);\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   HERO\par
═══════════════════════════════════════════ */\par
.hero \{\par
  text-align: center;\par
  padding: var(--space-12) var(--space-6) var(--space-8);\par
\}\par
\par
.hero-badge \{\par
  display: inline-flex;\par
  align-items: center;\par
  gap: var(--space-2);\par
  background: rgba(102, 126, 234, 0.12);\par
  border: 1px solid rgba(102, 126, 234, 0.25);\par
  border-radius: var(--radius-xl);\par
  padding: 4px 14px;\par
  font-size: 12px;\par
  font-weight: 600;\par
  color: var(--accent-light);\par
  margin-bottom: var(--space-5);\par
  letter-spacing: 0.5px;\par
  text-transform: uppercase;\par
\}\par
\par
.hero-badge .dot \{\par
  width: 6px;\par
  height: 6px;\par
  border-radius: 50%;\par
  background: var(--success);\par
  animation: pulse 2s infinite;\par
\}\par
\par
@keyframes pulse \{\par
\par
  0%,\par
  100% \{\par
    opacity: 1;\par
    transform: scale(1);\par
  \}\par
\par
  50% \{\par
    opacity: 0.5;\par
    transform: scale(1.3);\par
  \}\par
\}\par
\par
.hero h1 \{\par
  font-size: clamp(28px, 5vw, 52px);\par
  font-weight: 800;\par
  line-height: 1.2;\par
  letter-spacing: -1.5px;\par
  background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-light) 100%);\par
  -webkit-background-clip: text;\par
  -webkit-text-fill-color: transparent;\par
  background-clip: text;\par
  margin-bottom: var(--space-4);\par
\}\par
\par
.hero p \{\par
  font-size: clamp(14px, 2vw, 18px);\par
  color: var(--text-secondary);\par
  max-width: 560px;\par
  margin: 0 auto var(--space-6);\par
\}\par
\par
.feature-chips \{\par
  display: flex;\par
  flex-wrap: wrap;\par
  justify-content: center;\par
  gap: var(--space-2);\par
\}\par
\par
.chip \{\par
  padding: 5px 14px;\par
  background: var(--bg-chip);\par
  border: 1px solid var(--border-accent);\par
  border-radius: var(--radius-xl);\par
  font-size: 12px;\par
  font-weight: 600;\par
  color: var(--accent-light);\par
  letter-spacing: 0.3px;\par
  transition: all var(--transition);\par
\}\par
\par
.chip:hover \{\par
  background: rgba(102, 126, 234, 0.25);\par
  transform: translateY(-2px);\par
\}\par
\par
.chip .ci \{\par
  margin-right: 4px;\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   MAIN LAYOUT\par
═══════════════════════════════════════════ */\par
.main-layout \{\par
  flex: 1;\par
  display: grid;\par
  grid-template-columns: 1fr 300px;\par
  gap: var(--space-6);\par
  padding: 0 var(--space-6) var(--space-12);\par
  max-width: 1300px;\par
  margin: 0 auto;\par
  width: 100%;\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   UPLOAD PANEL\par
═══════════════════════════════════════════ */\par
.upload-panel \{\par
  grid-column: 1 / -1;\par
  padding: var(--space-8);\par
\}\par
\par
.drop-zone \{\par
  border: 2px dashed var(--border-accent);\par
  border-radius: var(--radius-lg);\par
  padding: var(--space-10) var(--space-6);\par
  text-align: center;\par
  cursor: pointer;\par
  transition: all var(--transition);\par
  position: relative;\par
  overflow: hidden;\par
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.04) 0%, rgba(118, 75, 162, 0.04) 100%);\par
\}\par
\par
.drop-zone:hover,\par
.drop-zone.drag-over \{\par
  border-color: var(--accent);\par
  background: rgba(102, 126, 234, 0.08);\par
  transform: translateY(-2px);\par
  box-shadow: var(--shadow-glow);\par
\}\par
\par
.drop-zone input[type="file"] \{\par
  display: none;\par
\}\par
\par
.drop-icon \{\par
  font-size: 48px;\par
  margin-bottom: var(--space-4);\par
  background: var(--gradient-accent);\par
  -webkit-background-clip: text;\par
  -webkit-text-fill-color: transparent;\par
  background-clip: text;\par
  display: block;\par
\}\par
\par
.drop-zone h3 \{\par
  font-size: 18px;\par
  font-weight: 700;\par
  margin-bottom: var(--space-2);\par
\}\par
\par
.drop-zone p \{\par
  color: var(--text-secondary);\par
  font-size: 14px;\par
\}\par
\par
.drop-formats \{\par
  margin-top: var(--space-3);\par
  display: flex;\par
  justify-content: center;\par
  gap: var(--space-2);\par
  flex-wrap: wrap;\par
\}\par
\par
.fmt-badge \{\par
  padding: 3px 10px;\par
  border: 1px solid var(--border);\par
  border-radius: var(--radius-xl);\par
  font-size: 11px;\par
  font-weight: 600;\par
  color: var(--text-muted);\par
  font-family: var(--font-mono);\par
\}\par
\par
/* File info bar */\par
.file-info \{\par
  display: none;\par
  margin-top: var(--space-4);\par
  padding: var(--space-4) var(--space-5);\par
  background: var(--bg-input);\par
  border: 1px solid var(--border);\par
  border-radius: var(--radius-md);\par
  align-items: center;\par
  gap: var(--space-4);\par
\}\par
\par
.file-info.show \{\par
  display: flex;\par
\}\par
\par
.file-icon \{\par
  font-size: 28px;\par
  flex-shrink: 0;\par
\}\par
\par
.file-meta \{\par
  flex: 1;\par
\}\par
\par
.file-name \{\par
  font-weight: 700;\par
  font-size: 14px;\par
\}\par
\par
.file-detail \{\par
  font-size: 12px;\par
  color: var(--text-secondary);\par
  margin-top: 2px;\par
\}\par
\par
.file-remove \{\par
  background: none;\par
  border: none;\par
  color: var(--text-muted);\par
  font-size: 18px;\par
  cursor: pointer;\par
  padding: var(--space-2);\par
  transition: color var(--transition);\par
\}\par
\par
.file-remove:hover \{\par
  color: var(--error);\par
\}\par
\par
/* Video preview */\par
.video-preview-wrap \{\par
  display: none;\par
  margin-top: var(--space-5);\par
  border-radius: var(--radius-md);\par
  overflow: hidden;\par
  border: 1px solid var(--border);\par
  background: #000;\par
  max-height: 300px;\par
\}\par
\par
.video-preview-wrap.show \{\par
  display: block;\par
\}\par
\par
.video-preview-wrap video \{\par
  width: 100%;\par
  max-height: 300px;\par
  display: block;\par
\}\par
\par
/* Controls row */\par
.upload-controls \{\par
  margin-top: var(--space-5);\par
  display: flex;\par
  gap: var(--space-4);\par
  align-items: flex-end;\par
  flex-wrap: wrap;\par
\}\par
\par
.form-group \{\par
  display: flex;\par
  flex-direction: column;\par
  gap: var(--space-2);\par
\}\par
\par
.form-label \{\par
  font-size: 12px;\par
  font-weight: 600;\par
  color: var(--text-secondary);\par
  text-transform: uppercase;\par
  letter-spacing: 0.5px;\par
\}\par
\par
.select-styled \{\par
  appearance: none;\par
  background: var(--bg-input);\par
  border: 1px solid var(--border);\par
  border-radius: var(--radius-sm);\par
  color: var(--text-primary);\par
  padding: 10px 36px 10px 14px;\par
  font-size: 14px;\par
  font-family: var(--font-sans);\par
  font-weight: 500;\par
  cursor: pointer;\par
  background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%238b91b8' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");\par
  background-repeat: no-repeat;\par
  background-position: right 10px center;\par
  background-size: 20px;\par
  transition: border-color var(--transition);\par
  min-width: 160px;\par
\}\par
\par
.select-styled:focus \{\par
  outline: none;\par
  border-color: var(--accent);\par
\}\par
\par
/* Mode toggle */\par
.mode-toggle \{\par
  display: flex;\par
  gap: 2px;\par
  background: var(--bg-input);\par
  border: 1px solid var(--border);\par
  border-radius: var(--radius-sm);\par
  padding: 3px;\par
\}\par
\par
.mode-opt \{\par
  padding: 8px 14px;\par
  border: none;\par
  background: none;\par
  color: var(--text-secondary);\par
  border-radius: 8px;\par
  font-size: 13px;\par
  font-weight: 500;\par
  font-family: var(--font-sans);\par
  cursor: pointer;\par
  transition: all var(--transition);\par
  white-space: nowrap;\par
\}\par
\par
.mode-opt.active \{\par
  background: var(--gradient-accent);\par
  color: #fff;\par
  box-shadow: 0 2px 8px rgba(102, 126, 234, 0.4);\par
\}\par
\par
.mode-opt:hover:not(.active) \{\par
  color: var(--text-primary);\par
  background: rgba(255, 255, 255, 0.05);\par
\}\par
\par
/* Primary button */\par
.btn-primary \{\par
  padding: 11px 28px;\par
  background: var(--gradient-accent);\par
  color: #fff;\par
  border: none;\par
  border-radius: var(--radius-sm);\par
  font-size: 14px;\par
  font-weight: 700;\par
  font-family: var(--font-sans);\par
  cursor: pointer;\par
  transition: all var(--transition);\par
  display: flex;\par
  align-items: center;\par
  gap: var(--space-2);\par
  box-shadow: 0 4px 20px rgba(102, 126, 234, 0.35);\par
  white-space: nowrap;\par
  margin-left: auto;\par
\}\par
\par
.btn-primary:hover \{\par
  transform: translateY(-2px);\par
  box-shadow: 0 8px 28px rgba(102, 126, 234, 0.5);\par
\}\par
\par
.btn-primary:active \{\par
  transform: translateY(0);\par
\}\par
\par
.btn-primary:disabled \{\par
  opacity: 0.45;\par
  cursor: not-allowed;\par
  transform: none;\par
  box-shadow: none;\par
\}\par
\par
/* Secondary button */\par
.btn-secondary \{\par
  padding: 9px 18px;\par
  background: rgba(102, 126, 234, 0.1);\par
  color: var(--accent-light);\par
  border: 1px solid var(--border-accent);\par
  border-radius: var(--radius-sm);\par
  font-size: 13px;\par
  font-weight: 600;\par
  font-family: var(--font-sans);\par
  cursor: pointer;\par
  transition: all var(--transition);\par
  display: inline-flex;\par
  align-items: center;\par
  gap: var(--space-2);\par
  white-space: nowrap;\par
\}\par
\par
.btn-secondary:hover \{\par
  background: rgba(102, 126, 234, 0.2);\par
  transform: translateY(-1px);\par
\}\par
\par
.btn-secondary:disabled \{\par
  opacity: 0.4;\par
  cursor: not-allowed;\par
  transform: none;\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   PROGRESS TIMELINE\par
═══════════════════════════════════════════ */\par
.progress-panel \{\par
  display: none;\par
  margin-top: var(--space-6);\par
  padding: var(--space-6);\par
  border-radius: var(--radius-md);\par
  background: var(--bg-input);\par
  border: 1px solid var(--border-accent);\par
\}\par
\par
.progress-panel.show \{\par
  display: block;\par
\}\par
\par
.progress-header \{\par
  display: flex;\par
  justify-content: space-between;\par
  align-items: center;\par
  margin-bottom: var(--space-4);\par
\}\par
\par
.progress-title \{\par
  font-size: 14px;\par
  font-weight: 700;\par
\}\par
\par
.progress-pct \{\par
  font-size: 13px;\par
  font-weight: 700;\par
  color: var(--accent-light);\par
  font-family: var(--font-mono);\par
\}\par
\par
.progress-bar-outer \{\par
  height: 6px;\par
  background: var(--border);\par
  border-radius: 99px;\par
  margin-bottom: var(--space-5);\par
  overflow: hidden;\par
\}\par
\par
.progress-bar-inner \{\par
  height: 100%;\par
  border-radius: 99px;\par
  background: var(--gradient-accent);\par
  transition: width 0.6s var(--ease);\par
  box-shadow: 0 0 12px rgba(102, 126, 234, 0.5);\par
  width: 0%;\par
\}\par
\par
.progress-steps \{\par
  display: flex;\par
  flex-direction: column;\par
  gap: var(--space-3);\par
\}\par
\par
.progress-step \{\par
  display: flex;\par
  align-items: center;\par
  gap: var(--space-3);\par
\}\par
\par
.step-icon \{\par
  width: 28px;\par
  height: 28px;\par
  border-radius: 50%;\par
  flex-shrink: 0;\par
  display: flex;\par
  align-items: center;\par
  justify-content: center;\par
  font-size: 12px;\par
  border: 2px solid var(--border);\par
  color: var(--text-muted);\par
  transition: all var(--transition);\par
\}\par
\par
.step-icon.active \{\par
  border-color: var(--accent);\par
  color: var(--accent);\par
  animation: spinStep 1s linear infinite;\par
\}\par
\par
.step-icon.done \{\par
  border-color: var(--success);\par
  background: var(--success);\par
  color: #fff;\par
\}\par
\par
.step-icon.done::after \{\par
  content: '✓';\par
\}\par
\par
@keyframes spinStep \{\par
  to \{\par
    transform: rotate(360deg);\par
  \}\par
\}\par
\par
.step-label \{\par
  font-size: 13px;\par
  font-weight: 500;\par
  color: var(--text-secondary);\par
  transition: color var(--transition);\par
\}\par
\par
.step-label.active \{\par
  color: var(--text-primary);\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   CONTENT AREA + SIDEBAR LAYOUT\par
═══════════════════════════════════════════ */\par
.content-area \{\par
  min-width: 0;\par
\}\par
\par
.sidebar \{\par
  position: relative;\par
\}\par
\par
/* Tab panels */\par
.tab-panel \{\par
  display: none;\par
  animation: fadeUp 0.3s var(--ease);\par
\}\par
\par
.tab-panel.active \{\par
  display: block;\par
\}\par
\par
@keyframes fadeUp \{\par
  from \{\par
    opacity: 0;\par
    transform: translateY(12px);\par
  \}\par
\par
  to \{\par
    opacity: 1;\par
    transform: translateY(0);\par
  \}\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   ASK TAB\par
═══════════════════════════════════════════ */\par
.qa-input-card \{\par
  padding: var(--space-6);\par
  margin-bottom: var(--space-4);\par
\}\par
\par
.qa-input-card h2 \{\par
  font-size: 17px;\par
  font-weight: 700;\par
  margin-bottom: var(--space-4);\par
\}\par
\par
.question-area \{\par
  width: 100%;\par
  background: var(--bg-input);\par
  border: 1px solid var(--border);\par
  border-radius: var(--radius-md);\par
  padding: var(--space-4);\par
  color: var(--text-primary);\par
  font-family: var(--font-sans);\par
  font-size: 14px;\par
  line-height: 1.7;\par
  resize: vertical;\par
  min-height: 90px;\par
  transition: border-color var(--transition);\par
\}\par
\par
.question-area:focus \{\par
  outline: none;\par
  border-color: var(--accent);\par
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);\par
\}\par
\par
.question-area::placeholder \{\par
  color: var(--text-muted);\par
\}\par
\par
.qa-actions \{\par
  display: flex;\par
  gap: var(--space-2);\par
  flex-wrap: wrap;\par
  margin-top: var(--space-3);\par
\}\par
\par
/* Answer card */\par
.result-card \{\par
  padding: var(--space-6);\par
  margin-bottom: var(--space-4);\par
  animation: fadeUp 0.35s var(--ease);\par
\}\par
\par
.result-card-header \{\par
  display: flex;\par
  align-items: center;\par
  justify-content: space-between;\par
  margin-bottom: var(--space-4);\par
  gap: var(--space-3);\par
\}\par
\par
.result-label \{\par
  display: flex;\par
  align-items: center;\par
  gap: var(--space-2);\par
  font-size: 11px;\par
  font-weight: 700;\par
  text-transform: uppercase;\par
  letter-spacing: 0.8px;\par
  color: var(--text-secondary);\par
\}\par
\par
.result-label .dot-accent \{\par
  width: 8px;\par
  height: 8px;\par
  border-radius: 50%;\par
  background: var(--gradient-accent);\par
\}\par
\par
.result-actions \{\par
  display: flex;\par
  gap: var(--space-2);\par
\}\par
\par
.answer-text \{\par
  font-size: 15px;\par
  line-height: 1.8;\par
  color: var(--text-primary);\par
  white-space: pre-wrap;\par
\}\par
\par
.answer-text strong \{\par
  color: var(--accent-light);\par
\}\par
\par
.confidence-badge \{\par
  display: inline-flex;\par
  align-items: center;\par
  gap: var(--space-2);\par
  margin-top: var(--space-4);\par
  padding: 6px 14px;\par
  background: rgba(52, 211, 153, 0.1);\par
  border: 1px solid rgba(52, 211, 153, 0.25);\par
  border-radius: var(--radius-xl);\par
  font-size: 12px;\par
  font-weight: 600;\par
  color: var(--success);\par
\}\par
\par
.confidence-badge::before \{\par
  content: '✦';\par
\}\par
\par
/* Clip card */\par
.clip-card \{\par
  padding: var(--space-6);\par
  margin-bottom: var(--space-4);\par
\}\par
\par
.clip-player-wrap \{\par
  border-radius: var(--radius-md);\par
  overflow: hidden;\par
  background: #000;\par
  margin-bottom: var(--space-4);\par
  border: 1px solid var(--border);\par
  min-height: 160px;\par
  display: flex;\par
  align-items: center;\par
  justify-content: center;\par
\}\par
\par
.clip-placeholder \{\par
  display: flex;\par
  flex-direction: column;\par
  align-items: center;\par
  gap: var(--space-3);\par
  color: var(--text-muted);\par
  padding: var(--space-8);\par
\}\par
\par
.clip-placeholder span \{\par
  font-size: 36px;\par
\}\par
\par
.clip-placeholder p \{\par
  font-size: 13px;\par
\}\par
\par
.clip-label \{\par
  font-size: 13px;\par
  font-weight: 600;\par
  color: var(--accent-light);\par
  margin-bottom: var(--space-3);\par
\}\par
\par
.clip-actions \{\par
  display: flex;\par
  gap: var(--space-2);\par
  flex-wrap: wrap;\par
\}\par
\par
/* Evidence collapsible */\par
.evidence-card \{\par
  padding: var(--space-4) var(--space-5);\par
  margin-bottom: var(--space-4);\par
\}\par
\par
.evidence-toggle \{\par
  display: flex;\par
  align-items: center;\par
  justify-content: space-between;\par
  cursor: pointer;\par
  user-select: none;\par
\}\par
\par
.evidence-toggle h4 \{\par
  font-size: 13px;\par
  font-weight: 700;\par
  display: flex;\par
  align-items: center;\par
  gap: var(--space-2);\par
\}\par
\par
.toggle-arrow \{\par
  font-size: 12px;\par
  color: var(--text-muted);\par
  transition: transform var(--transition);\par
\}\par
\par
.toggle-arrow.open \{\par
  transform: rotate(180deg);\par
\}\par
\par
.evidence-body \{\par
  display: none;\par
  margin-top: var(--space-4);\par
\}\par
\par
.evidence-body.show \{\par
  display: block;\par
\}\par
\par
.evidence-section \{\par
  margin-bottom: var(--space-4);\par
\}\par
\par
.evidence-section:last-child \{\par
  margin-bottom: 0;\par
\}\par
\par
.evidence-title \{\par
  font-size: 11px;\par
  font-weight: 700;\par
  text-transform: uppercase;\par
  letter-spacing: 0.6px;\par
  color: var(--text-muted);\par
  margin-bottom: var(--space-2);\par
\}\par
\par
.evidence-item \{\par
  padding: var(--space-3) var(--space-4);\par
  margin-bottom: var(--space-2);\par
  background: var(--bg-input);\par
  border-left: 3px solid var(--accent);\par
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;\par
  font-size: 13px;\par
  line-height: 1.6;\par
  color: var(--text-secondary);\par
  font-style: italic;\par
\}\par
\par
/* Demo state */\par
.demo-state \{\par
  padding: var(--space-10) var(--space-6);\par
  text-align: center;\par
  color: var(--text-muted);\par
\}\par
\par
.demo-icon \{\par
  font-size: 52px;\par
  margin-bottom: var(--space-4);\par
  display: block;\par
\}\par
\par
.demo-state h3 \{\par
  font-size: 18px;\par
  font-weight: 700;\par
  color: var(--text-secondary);\par
  margin-bottom: var(--space-2);\par
\}\par
\par
.demo-state p \{\par
  font-size: 14px;\par
  max-width: 340px;\par
  margin: 0 auto;\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   SUMMARIZE TAB\par
═══════════════════════════════════════════ */\par
.summarize-grid \{\par
  display: grid;\par
  grid-template-columns: 1fr 1fr;\par
  gap: var(--space-4);\par
  margin-bottom: var(--space-4);\par
\}\par
\par
@media (max-width: 900px) \{\par
  .summarize-grid \{\par
    grid-template-columns: 1fr;\par
  \}\par
\}\par
\par
.summarize-section \{\par
  padding: var(--space-6);\par
\}\par
\par
.summarize-section h3 \{\par
  font-size: 16px;\par
  font-weight: 700;\par
  margin-bottom: var(--space-4);\par
  display: flex;\par
  align-items: center;\par
  gap: var(--space-2);\par
\}\par
\par
.summary-toggle \{\par
  display: flex;\par
  gap: 2px;\par
  background: var(--bg-input);\par
  border: 1px solid var(--border);\par
  border-radius: var(--radius-sm);\par
  padding: 3px;\par
  margin-bottom: var(--space-4);\par
\}\par
\par
.sum-opt \{\par
  flex: 1;\par
  padding: 7px 10px;\par
  border: none;\par
  background: none;\par
  color: var(--text-secondary);\par
  border-radius: 8px;\par
  font-size: 12px;\par
  font-weight: 600;\par
  font-family: var(--font-sans);\par
  cursor: pointer;\par
  transition: all var(--transition);\par
  text-align: center;\par
\}\par
\par
.sum-opt.active \{\par
  background: var(--gradient-accent);\par
  color: #fff;\par
\}\par
\par
.sum-opt:hover:not(.active) \{\par
  color: var(--text-primary);\par
\}\par
\par
.summary-output \{\par
  min-height: 80px;\par
  font-size: 14px;\par
  line-height: 1.8;\par
  color: var(--text-secondary);\par
\}\par
\par
.summary-bullet \{\par
  display: flex;\par
  gap: var(--space-3);\par
  margin-bottom: var(--space-3);\par
  align-items: flex-start;\par
\}\par
\par
.summary-bullet::before \{\par
  content: '▸';\par
  color: var(--accent);\par
  flex-shrink: 0;\par
  margin-top: 2px;\par
\}\par
\par
.chapters-list \{\par
  display: flex;\par
  flex-direction: column;\par
  gap: var(--space-2);\par
\}\par
\par
.chapter-item \{\par
  display: flex;\par
  gap: var(--space-3);\par
  align-items: center;\par
  padding: var(--space-3) var(--space-4);\par
  background: var(--bg-input);\par
  border-radius: var(--radius-sm);\par
  border: 1px solid var(--border);\par
  transition: border-color var(--transition);\par
\}\par
\par
.chapter-item:hover \{\par
  border-color: var(--border-accent);\par
\}\par
\par
.chapter-time \{\par
  font-size: 12px;\par
  font-weight: 700;\par
  color: var(--accent-light);\par
  font-family: var(--font-mono);\par
  flex-shrink: 0;\par
  min-width: 44px;\par
\}\par
\par
.chapter-title \{\par
  font-size: 13px;\par
  font-weight: 500;\par
\}\par
\par
.kw-chips \{\par
  display: flex;\par
  flex-wrap: wrap;\par
  gap: var(--space-2);\par
  margin-top: var(--space-3);\par
\}\par
\par
.kw-chip \{\par
  padding: 4px 12px;\par
  background: var(--bg-chip);\par
  border: 1px solid var(--border-accent);\par
  border-radius: var(--radius-xl);\par
  font-size: 12px;\par
  font-weight: 600;\par
  color: var(--accent-light);\par
  cursor: default;\par
  transition: background var(--transition);\par
\}\par
\par
.kw-chip:hover \{\par
  background: rgba(102, 126, 234, 0.25);\par
\}\par
\par
.action-items \{\par
  list-style: none;\par
  display: flex;\par
  flex-direction: column;\par
  gap: var(--space-2);\par
  margin-top: var(--space-3);\par
\}\par
\par
.action-items li \{\par
  padding: var(--space-3) var(--space-4);\par
  background: var(--bg-input);\par
  border-radius: var(--radius-sm);\par
  border-left: 3px solid var(--warning);\par
  font-size: 13px;\par
  color: var(--text-secondary);\par
  line-height: 1.6;\par
\}\par
\par
.export-row \{\par
  display: flex;\par
  gap: var(--space-2);\par
  flex-wrap: wrap;\par
  margin-top: var(--space-4);\par
  padding-top: var(--space-4);\par
  border-top: 1px solid var(--border);\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   TRANSCRIPT TAB\par
═══════════════════════════════════════════ */\par
.transcript-toolbar \{\par
  display: flex;\par
  gap: var(--space-3);\par
  align-items: center;\par
  flex-wrap: wrap;\par
  padding: var(--space-4) var(--space-6);\par
  border-bottom: 1px solid var(--border);\par
  margin-bottom: 0;\par
\}\par
\par
.search-wrap \{\par
  position: relative;\par
  flex: 1;\par
  min-width: 180px;\par
\}\par
\par
.search-wrap svg \{\par
  position: absolute;\par
  left: 12px;\par
  top: 50%;\par
  transform: translateY(-50%);\par
  color: var(--text-muted);\par
\}\par
\par
.search-input \{\par
  width: 100%;\par
  padding: 9px 12px 9px 36px;\par
  background: var(--bg-input);\par
  border: 1px solid var(--border);\par
  border-radius: var(--radius-sm);\par
  color: var(--text-primary);\par
  font-size: 13px;\par
  font-family: var(--font-sans);\par
  transition: border-color var(--transition);\par
\}\par
\par
.search-input:focus \{\par
  outline: none;\par
  border-color: var(--accent);\par
\}\par
\par
.search-input::placeholder \{\par
  color: var(--text-muted);\par
\}\par
\par
.speaker-toggle \{\par
  display: flex;\par
  align-items: center;\par
  gap: var(--space-2);\par
  font-size: 13px;\par
  font-weight: 500;\par
  color: var(--text-secondary);\par
  cursor: pointer;\par
\}\par
\par
.toggle-sw \{\par
  width: 38px;\par
  height: 22px;\par
  background: var(--border);\par
  border-radius: 99px;\par
  position: relative;\par
  transition: background var(--transition);\par
  cursor: pointer;\par
\}\par
\par
.toggle-sw.on \{\par
  background: var(--accent);\par
\}\par
\par
.toggle-sw::after \{\par
  content: '';\par
  position: absolute;\par
  top: 3px;\par
  left: 3px;\par
  width: 16px;\par
  height: 16px;\par
  background: #fff;\par
  border-radius: 50%;\par
  transition: left var(--transition);\par
\}\par
\par
.toggle-sw.on::after \{\par
  left: 19px;\par
\}\par
\par
.transcript-body \{\par
  padding: var(--space-4) var(--space-6);\par
  max-height: 520px;\par
  overflow-y: auto;\par
\}\par
\par
.transcript-line \{\par
  display: flex;\par
  gap: var(--space-4);\par
  padding: var(--space-3) var(--space-2);\par
  border-radius: var(--radius-sm);\par
  transition: background var(--transition);\par
  margin-bottom: 2px;\par
\}\par
\par
.transcript-line:hover \{\par
  background: rgba(102, 126, 234, 0.06);\par
\}\par
\par
.transcript-line.highlight \{\par
  background: rgba(102, 126, 234, 0.12);\par
\}\par
\par
.ts-time \{\par
  font-size: 12px;\par
  font-weight: 700;\par
  color: var(--accent-light);\par
  font-family: var(--font-mono);\par
  flex-shrink: 0;\par
  min-width: 42px;\par
  padding-top: 2px;\par
\}\par
\par
.ts-speaker \{\par
  font-size: 12px;\par
  font-weight: 700;\par
  color: var(--text-muted);\par
  flex-shrink: 0;\par
  min-width: 80px;\par
  padding-top: 2px;\par
\}\par
\par
.ts-text \{\par
  font-size: 14px;\par
  line-height: 1.7;\par
  color: var(--text-primary);\par
\}\par
\par
.ts-text mark \{\par
  background: rgba(102, 126, 234, 0.35);\par
  color: var(--text-primary);\par
  border-radius: 3px;\par
  padding: 0 2px;\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   HISTORY SIDEBAR\par
═══════════════════════════════════════════ */\par
.history-card \{\par
  position: sticky;\par
  top: 80px;\par
  padding: 0;\par
  overflow: hidden;\par
\}\par
\par
.history-header \{\par
  padding: var(--space-4) var(--space-5);\par
  border-bottom: 1px solid var(--border);\par
  display: flex;\par
  align-items: center;\par
  justify-content: space-between;\par
\}\par
\par
.history-header h3 \{\par
  font-size: 14px;\par
  font-weight: 700;\par
\}\par
\par
.history-count \{\par
  font-size: 11px;\par
  font-weight: 700;\par
  background: var(--bg-chip);\par
  color: var(--accent-light);\par
  padding: 2px 8px;\par
  border-radius: var(--radius-xl);\par
\}\par
\par
.history-list \{\par
  max-height: 480px;\par
  overflow-y: auto;\par
\}\par
\par
.history-item \{\par
  padding: var(--space-4) var(--space-5);\par
  border-bottom: 1px solid var(--border);\par
  cursor: pointer;\par
  transition: background var(--transition);\par
\}\par
\par
.history-item:hover \{\par
  background: rgba(102, 126, 234, 0.07);\par
\}\par
\par
.history-item.active \{\par
  background: rgba(102, 126, 234, 0.12);\par
  border-left: 3px solid var(--accent);\par
\}\par
\par
.hi-question \{\par
  font-size: 13px;\par
  font-weight: 600;\par
  line-height: 1.4;\par
  margin-bottom: 4px;\par
  display: -webkit-box;\par
  -webkit-line-clamp: 2;\par
  line-clamp: 2;\par
  -webkit-box-orient: vertical;\par
  overflow: hidden;\par
\}\par
\par
.hi-time \{\par
  font-size: 11px;\par
  color: var(--text-muted);\par
\}\par
\par
.history-empty \{\par
  padding: var(--space-6);\par
  text-align: center;\par
  color: var(--text-muted);\par
  font-size: 13px;\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   MODAL (How it works)\par
═══════════════════════════════════════════ */\par
.modal-overlay \{\par
  position: fixed;\par
  inset: 0;\par
  z-index: 200;\par
  background: rgba(0, 0, 0, 0.7);\par
  backdrop-filter: blur(6px);\par
  display: flex;\par
  align-items: center;\par
  justify-content: center;\par
  padding: var(--space-6);\par
  opacity: 0;\par
  pointer-events: none;\par
  transition: opacity var(--transition);\par
\}\par
\par
.modal-overlay.open \{\par
  opacity: 1;\par
  pointer-events: all;\par
\}\par
\par
.modal-box \{\par
  max-width: 560px;\par
  width: 100%;\par
  padding: var(--space-8);\par
  transform: translateY(20px);\par
  transition: transform var(--transition);\par
\}\par
\par
.modal-overlay.open .modal-box \{\par
  transform: translateY(0);\par
\}\par
\par
.modal-header \{\par
  display: flex;\par
  justify-content: space-between;\par
  align-items: center;\par
  margin-bottom: var(--space-6);\par
\}\par
\par
.modal-header h2 \{\par
  font-size: 22px;\par
  font-weight: 800;\par
\}\par
\par
.modal-close \{\par
  font-size: 24px;\par
  background: none;\par
  border: none;\par
  cursor: pointer;\par
  color: var(--text-secondary);\par
  transition: color var(--transition);\par
\}\par
\par
.modal-close:hover \{\par
  color: var(--text-primary);\par
\}\par
\par
.how-steps \{\par
  display: flex;\par
  flex-direction: column;\par
  gap: var(--space-5);\par
\}\par
\par
.how-step \{\par
  display: flex;\par
  gap: var(--space-4);\par
  align-items: flex-start;\par
\}\par
\par
.how-num \{\par
  width: 36px;\par
  height: 36px;\par
  border-radius: 50%;\par
  flex-shrink: 0;\par
  background: var(--gradient-accent);\par
  color: #fff;\par
  font-size: 15px;\par
  font-weight: 800;\par
  display: flex;\par
  align-items: center;\par
  justify-content: center;\par
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.35);\par
\}\par
\par
.how-step h4 \{\par
  font-size: 14px;\par
  font-weight: 700;\par
  margin-bottom: 4px;\par
\}\par
\par
.how-step p \{\par
  font-size: 13px;\par
  color: var(--text-secondary);\par
  line-height: 1.6;\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   TOAST NOTIFICATIONS\par
═══════════════════════════════════════════ */\par
.toast-container \{\par
  position: fixed;\par
  bottom: var(--space-6);\par
  right: var(--space-6);\par
  z-index: 999;\par
  display: flex;\par
  flex-direction: column;\par
  gap: var(--space-2);\par
  pointer-events: none;\par
\}\par
\par
.toast \{\par
  padding: 12px 18px;\par
  background: var(--glass-bg);\par
  backdrop-filter: var(--glass-blur);\par
  border: 1px solid var(--border);\par
  border-radius: var(--radius-md);\par
  font-size: 13px;\par
  font-weight: 600;\par
  color: var(--text-primary);\par
  box-shadow: var(--shadow-md);\par
  pointer-events: auto;\par
  display: flex;\par
  align-items: center;\par
  gap: var(--space-3);\par
  animation: toastIn 0.3s var(--ease) forwards;\par
  max-width: 320px;\par
\}\par
\par
.toast.removing \{\par
  animation: toastOut 0.3s var(--ease) forwards;\par
\}\par
\par
.toast-icon \{\par
  font-size: 16px;\par
  flex-shrink: 0;\par
\}\par
\par
.toast.success .toast-icon::before \{\par
  content: '✅';\par
\}\par
\par
.toast.error .toast-icon::before \{\par
  content: '❌';\par
\}\par
\par
.toast.info .toast-icon::before \{\par
  content: 'ℹ️';\par
\}\par
\par
@keyframes toastIn \{\par
  from \{\par
    opacity: 0;\par
    transform: translateX(30px);\par
  \}\par
\par
  to \{\par
    opacity: 1;\par
    transform: translateX(0);\par
  \}\par
\}\par
\par
@keyframes toastOut \{\par
  from \{\par
    opacity: 1;\par
    transform: translateX(0);\par
  \}\par
\par
  to \{\par
    opacity: 0;\par
    transform: translateX(30px);\par
  \}\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   ERROR CARD\par
═══════════════════════════════════════════ */\par
.error-card \{\par
  padding: var(--space-5) var(--space-6);\par
  background: rgba(248, 113, 113, 0.1);\par
  border: 1px solid rgba(248, 113, 113, 0.3);\par
  border-radius: var(--radius-md);\par
  display: flex;\par
  align-items: flex-start;\par
  gap: var(--space-4);\par
  margin-bottom: var(--space-4);\par
\}\par
\par
.error-card .err-icon \{\par
  font-size: 22px;\par
  flex-shrink: 0;\par
\}\par
\par
.error-card h4 \{\par
  font-size: 14px;\par
  font-weight: 700;\par
  color: var(--error);\par
  margin-bottom: 4px;\par
\}\par
\par
.error-card p \{\par
  font-size: 13px;\par
  color: var(--text-secondary);\par
  line-height: 1.6;\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   LOADING SPINNER\par
═══════════════════════════════════════════ */\par
.spinner \{\par
  width: 18px;\par
  height: 18px;\par
  border: 2px solid rgba(255, 255, 255, 0.25);\par
  border-top-color: #fff;\par
  border-radius: 50%;\par
  animation: spin 0.8s linear infinite;\par
  display: inline-block;\par
\}\par
\par
@keyframes spin \{\par
  to \{\par
    transform: rotate(360deg);\par
  \}\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   UTILITY\par
═══════════════════════════════════════════ */\par
.sr-only \{\par
  position: absolute;\par
  width: 1px;\par
  height: 1px;\par
  padding: 0;\par
  margin: -1px;\par
  overflow: hidden;\par
  clip: rect(0, 0, 0, 0);\par
  white-space: nowrap;\par
  border: 0;\par
\}\par
\par
.hidden \{\par
  display: none !important;\par
\}\par
\par
.mt-2 \{\par
  margin-top: var(--space-2);\par
\}\par
\par
.mt-4 \{\par
  margin-top: var(--space-4);\par
\}\par
\par
.gap-2 \{\par
  gap: var(--space-2);\par
\}\par
\par
.flex \{\par
  display: flex;\par
\}\par
\par
.flex-wrap \{\par
  flex-wrap: wrap;\par
\}\par
\par
.items-center \{\par
  align-items: center;\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   FOOTER\par
═══════════════════════════════════════════ */\par
.footer \{\par
  text-align: center;\par
  padding: var(--space-6);\par
  border-top: 1px solid var(--border);\par
  font-size: 12px;\par
  color: var(--text-muted);\par
\}\par
\par
.footer a \{\par
  color: var(--accent-light);\par
  text-decoration: none;\par
\}\par
\par
/* ═══════════════════════════════════════════\par
   RESPONSIVE\par
═══════════════════════════════════════════ */\par
@media (max-width: 1024px) \{\par
  .main-layout \{\par
    grid-template-columns: 1fr;\par
  \}\par
\par
  .sidebar \{\par
    display: none;\par
  \}\par
\par
  .sidebar.mobile-open \{\par
    display: block;\par
    position: fixed;\par
    inset: 0;\par
    z-index: 150;\par
    background: rgba(0, 0, 0, 0.6);\par
    backdrop-filter: blur(4px);\par
  \}\par
\par
  .sidebar.mobile-open .history-card \{\par
    position: absolute;\par
    right: 0;\par
    top: 0;\par
    bottom: 0;\par
    width: 320px;\par
    border-radius: 0;\par
    max-height: 100vh;\par
    overflow-y: auto;\par
  \}\par
\par
  .history-btn-mobile \{\par
    display: flex !important;\par
  \}\par
\}\par
\par
