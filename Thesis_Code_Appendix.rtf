\par
async function handleAsk() \{\par
  const input = $('question-input');\par
  if (!input) return;\par
  const question = input.value.trim();\par
  if (!question) \{ showToast('Please enter a question.', 'info'); return; \}\par
\par
  const askBtn = $('ask-btn');\par
  const regenBtn = $('regen-btn');\par
  askBtn.disabled = true;\par
  askBtn.innerHTML = '<span class="spinner"></span> Thinking…';\par
\par
  const area = $('answer-area');\par
  area.innerHTML = '<div class="demo-state"><span class="demo-icon" style="font-size:28px;animation:pulse 1.5s infinite">🧠</span><p>Analyzing video and generating answer…</p></div>';\par
\par
  try \{\par
    const language = $('language-select')?.value || 'en';\par
    const result = await apiAsk(question, language);\par
\par
    // Push to history\par
    addToHistory(question, result);\par
\par
    // Render\par
    renderAnswerCards(result, area);\par
\par
    regenBtn.disabled = false;\par
  \} catch (err) \{\par
    area.innerHTML = '';\par
    showErrorCard(area, 'Failed to get answer', err.message || 'Please try again.');\par
  \} finally \{\par
    askBtn.disabled = false;\par
    askBtn.innerHTML = '<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m5 12 7-7 7 7M12 5v14"/></svg> Ask Question';\par
  \}\par
\}\par
\par
function renderAnswerCards(result, container) \{\par
  const answerHtml = result.answer.replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>');\par
