{\b\f0\fs28 main.py\par}
{\f1\fs20 """\par
main.py – VideoQA FastAPI Backend\par
Endpoints: /process_video, /ask, /summarize_video, /summarize_transcript, /download/\{type\}\par
"""\par
\par
import os\par
import time\par
import uuid\par
import shutil\par
from pathlib import Path\par
from typing import Optional\par
import yt_dlp\par
\par
# Triggering reload\par
from fastapi import FastAPI, File, Form, UploadFile, HTTPException, BackgroundTasks\par
from fastapi.middleware.cors import CORSMiddleware\par
from fastapi.staticfiles import StaticFiles\par
from fastapi.responses import FileResponse, JSONResponse\par
from pydantic import BaseModel\par
from dotenv import load_dotenv\par
\par
from models import save_session, get_session, get_model_status\par
from video_utils import (\par
    extract_audio,\par
    extract_keyframes,\par
    extract_specific_frames,\par
    caption_frames,\par
    extract_clip,\par
    find_clip_timestamps,\par
)\par
from llm import answer_question, summarize_video, summarize_transcript\par
\par
load_dotenv()\par
\par
# ── App Setup ────────────────────────────────────────────────\par
app = FastAPI(\par
    title="VideoQA API",\par
    description="Multimodal Video Question Answering – Whisper + BLIP + Mistral",\par
    version="1.0.0",\par
)\par
\par
# Allow the file:// frontend and localhost dev servers\par
app.add_middleware(\par
    CORSMiddleware,\par
    allow_origins=["*"],          # In production, restrict to your domain\par
    allow_credentials=True,\par
    allow_methods=["*"],\par
    allow_headers=["*"],\par
)\par
\par
# Temp directory for uploads / outputs\par
UPLOAD_DIR = Path("uploads")\par
OUTPUT_DIR = Path("outputs")\par
UPLOAD_DIR.mkdir(exist_ok=True)\par
OUTPUT_DIR.mkdir(exist_ok=True)\par
\par
\par
# ── Pydantic models ──────────────────────────────────────────\par
\par
class AskRequest(BaseModel):\par
    question: str\par
    session_id: str\par
    language: Optional[str] = "English"\par
    model: Optional[str] = None   # None → use DEFAULT_MODEL from .env\par
\par
class SummarizeVideoRequest(BaseModel):\par
    session_id: str\par
    length: Optional[str] = "short"   # "short" | "detailed" | "chapters"\par
    model: Optional[str] = None\par
\par
class SummarizeTranscriptRequest(BaseModel):\par
    session_id: str\par
    model: Optional[str] = None\par
\par
\par
# ── Health Check ─────────────────────────────────────────────\par
\par
@app.get("/health")\par
def health():\par
    return \{"status": "ok", "service": "VideoQA API"\}\par
\par
\par
# ── Model Status ──────────────────────────────────────────────\par
\par
@app.get("/status")\par
def status():\par
    """\par
    Returns the load status of AI models (Whisper, BLIP).\par
    Use this to check if models are loaded before processing.\par
    """\par
    model_info = get_model_status()\par
    all_ready = all(\par
        v["status"] == "ready"\par
        for k, v in model_info.items()\par
        if isinstance(v, dict) and "status" in v\par
    )\par
    return \{\par
        "ready": all_ready,\par
        "models": model_info,\par
    \}\par
\par
\par
# ── POST /process_video ──────────────────────────────────────\par
\par
@app.post("/process_video")\par
async def process_video(\par
    video:    Optional[UploadFile] = File(None),\par
    video_url: Optional[str]       = Form(None),\par
    language: str                  = Form("English"),\par
    mode:     str                  = Form("fast"),      # "fast" | "full"\par
    start_time: Optional[float]    = Form(None),\par
    end_time:   Optional[float]    = Form(None),\par
    manual_frames: Optional[str]   = Form(None),\par
):\par
    """\par
    1. Save uploaded video\par
    2. Extract audio → transcribe with Whisper-base (fast)\par
    3. Extract keyframes → caption with BLIP-base\par
    4. Store session data\par
    Returns: \{ session_id, duration, transcript (list), visuals (list), status \}\par
    """\par
    t_pipeline = time.time()\par
    session_id = str(uuid.uuid4())\par
    session_dir = UPLOAD_DIR / session_id\par
    session_dir.mkdir(parents=True, exist_ok=True)\par
\par
    if not video and not video_url:\par
        raise HTTPException(status_code=400, detail="Must provide either a video file or a video URL")\par
\par
    print(f"\\n[VideoQA] -- New session: \{session_id[:8]\} | lang=\{language\} | mode=\{mode\}")\par
    t0 = time.time()\par
\par
    if video_url:\par
        print(f"[VideoQA] Downloading video from URL: \{video_url\}")\par
        browser = os.getenv("YOUTUBE_BROWSER", "chrome")\par
        ydl_opts = \{\par
            'format': 'best[ext=mp4]/best',\par
            'outtmpl': str(session_dir / 'downloaded_video.%(ext)s'),\par
            'quiet': True,\par
            'no_warnings': True,\par
            'extractor_args': \{'youtube': ['player_client=android,tv,ios']\},\par
        \}\par
        \par
        cookie_file = Path("cookies.txt")\par
        env_cookies = os.getenv("YOUTUBE_COOKIES_SECRET")\par
        if env_cookies and not cookie_file.exists():\par
            try:\par
                cookie_file.write_text(env_cookies, encoding="utf-8")\par
            except Exception:\par
                pass\par
                \par
        if cookie_file.exists():\par
            ydl_opts['cookiefile'] = str(cookie_file)\par
        elif browser and browser.lower() != "none" and browser.lower() != "false":\par
            ydl_opts['cookiesfrombrowser'] = (browser,)\par
\par
        def download_with_opts():\par
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:\par
                info = ydl.extract_info(video_url, download=True)\par
                ext = info.get('ext', 'mp4')\par
                return str(session_dir / f"downloaded_video.\{ext\}")\par
\par
        try:\par
            try:\par
                video_path = download_with_opts()\par
            except Exception as e:\par
                # If cookie extraction failed, retry without cookies\par
                if 'cookiesfrombrowser' in ydl_opts:\par
                    print(f"[VideoQA] Cookie extraction failed (\{e\}), retrying without cookies...")\par
                    del ydl_opts['cookiesfrombrowser']\par
                    video_path = download_with_opts()\par
                else:\par
                    raise e\par
            print(f"[VideoQA] Video downloaded in \{round(time.time()-t0,1)\}s")\par
        except Exception as e:\par
            shutil.rmtree(str(session_dir), ignore_errors=True)\par
            err_msg = str(e)\par
            \par
            is_youtube = "youtube.com" in video_url.lower() or "youtu.be" in video_url.lower()\par
            if is_youtube and ("Sign in to confirm" in err_msg or "bot" in err_msg.lower()):\par
                err_msg = ("YouTube has blocked the download (Bot Detection). "\par
                           "Please export your YouTube cookies using the 'Get cookies.txt LOCALLY' extension "\par
                           "and save them as 'cookies.txt' in the 'backend' folder.")\par
            elif "huggingface.co" in video_url.lower():\par
                err_msg = f"Hugging Face download failed (likely due to a private repository or bot protection). Please download the video manually and upload the file instead. Original error: \{err_msg\}"\par
                \par
            raise HTTPException(status_code=400, detail=f"Failed to download video URL: \{err_msg\}")\par
    else:\par
        video_path = str(session_dir / video.filename)\par
        with open(video_path, "wb") as f:\par
            content = await video.read()\par
            f.write(content)\par
        print(f"[VideoQA] Video saved (\{len(content)/1024/1024:.1f\} MB) in \{round(time.time()-t0,1)\}s")\par
\par
    try:\par
        # ── Step 1: Audio → Transcript ──────────────────────\par
        audio_path = str(session_dir / "audio.wav")\par
        extract_audio(video_path, audio_path, start_time, end_time)\par
\par
        from models import get_whisper\par
        model_wh = get_whisper()\par
\par
        print(f"[VideoQA] Transcribing audio (lang=\{_lang_code(language)\})...")\par
        t0 = time.time()\par
        # Request word-level timestamps for better clip matching\par
        result = model_wh.transcribe(\par
            audio_path,\par
            language=_lang_code(language),\par
            word_timestamps=False,  # per-segment timestamps are enough\par
        )\par
        print(f"[VideoQA] Transcription done in \{round(time.time()-t0,1)\}s")\par
\par
        full_text = result["text"].strip()\par
        segments  = result.get("segments", [])\par
        print(f"[VideoQA] Transcript: \{len(segments)\} segments, \{len(full_text)\} chars")\par
\par
        # Format transcript lines for frontend\par
        transcript_lines = []\par
        offset = start_time or 0.0\par
        for seg in segments:\par
            seg["start"] = seg.get("start", 0) + offset\par
            seg["end"] = seg.get("end", 0) + offset\par
            start = seg["start"]\par
            end   = seg["end"]\par
            text  = seg.get("text", "").strip()\par
            if text:\par
                transcript_lines.append(\{\par
                    "time":    _fmt_time(start),\par
                    "start":   start,\par
                    "end":     end,\par
                    "speaker": "Speaker",   # speaker diarization would need pyannote\par
                    "text":    text,\par
                \})\par
\par
        # Get video duration\par
        duration = segments[-1]["end"] if segments else (end_time or 0.0)\par
\par
        # ── Step 2: Keyframes → Visual Captions ────────────\par
        from models import get_model_status as _ms\par
        \par
        t0 = time.time()\par
        if manual_frames and manual_frames.strip():\par
            timestamps = [float(x.strip()) for x in manual_frames.split(",") if x.strip()]\par
            print(f"[VideoQA] Extracting \{len(timestamps)\} manual frames...")\par
            frame_paths = extract_specific_frames(video_path, timestamps)\par
        else:\par
            max_frames = int(os.getenv("MAX_FRAMES", "3"))\par
            n_frames = max_frames if mode == "full" else max(2, max_frames - 1)\par
            print(f"[VideoQA] Extracting \{n_frames\} keyframes...")\par
            frame_paths = extract_keyframes(video_path, n=n_frames, start_sec=start_time, end_sec=end_time)\par
            \par
        print(f"[VideoQA] Frames extracted in \{round(time.time()-t0,1)\}s")\par
        captioned   = caption_frames(frame_paths)\par
\par
        visuals = []\par
        for item in captioned:\par
            # Note: For manual frames, caption might display `time` incorrectly if we just use `frame_index / fps`. We will let `extract_specific_frames` return the timestamp in `frame_index` or handle it properly. Wait, `frame_index` can just be the timestamp in seconds scaled up. Actually, we can return `\{path, timestamp\}` from `extract_specific_frames`, but wait, `caption_frames` reads `frame_\{idx\}.jpg`. It might be easier to just format `time` based on the frame index if `extracted_frames` works similarly. Let's adjust this.\par
            visuals.append(\{\par
                "time":    _fmt_time(item.get("frame_index", 0) / 25.0),  # This will be updated inside video_utils\par
                "caption": item["caption"],\par
            \})\par
\par
        # ── Save Session ────────────────────────────────────\par
        save_session(session_id, \{\par
            "video_path":  video_path,\par
            "audio_path":  audio_path,\par
            "full_text":   full_text,\par
            "segments":    segments,\par
            "transcript":  transcript_lines,\par
            "visuals":     visuals,\par
            "duration":    duration,\par
            "language":    language,\par
        \})\par
\par
        # Cleanup frames dir\par
        shutil.rmtree("frames", ignore_errors=True)\par
        print(f"[VideoQA] Pipeline complete in \{round(time.time()-t_pipeline,1)\}s total\\n")\par
\par
        return \{\par
            "status":      "success",\par
            "session_id":  session_id,\par
            "duration":    duration,\par
            "transcript":  transcript_lines,\par
            "visuals":     visuals,\par
            "language":    language,\par
        \}\par
\par
    except Exception as e:\par
        shutil.rmtree(str(session_dir), ignore_errors=True)\par
        print(f"[VideoQA] Pipeline failed after \{round(time.time()-t_pipeline,1)\}s: \{e\}")\par
        raise HTTPException(status_code=500, detail=f"Processing failed: \{str(e)\}")\par
\par
