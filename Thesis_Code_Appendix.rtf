# ── POST /ask ────────────────────────────────────────────────\par
\par
@app.post("/ask")\par
async def ask(req: AskRequest):\par
    """\par
    Answer a question grounded in the video's transcript + visuals.\par
    Returns: \{ answer, confidence, evidence, clip \}\par
    """\par
    session = get_session(req.session_id)\par
    if not session:\par
        raise HTTPException(status_code=404, detail="Session not found. Please process a video first.")\par
\par
    full_text = session["full_text"]\par
    visuals   = session["visuals"]\par
    segments  = session["segments"]\par
    duration  = session["duration"]\par
    language  = req.language or session.get("language", "English")\par
    # Convert short code ('en') → display name ('English') for LLM prompt\par
    language_display = _CODE_TO_NAME.get(language.lower(), language)\par
\par
    visuals_text = "\\n".join(\par
        f"[\{v['time']\}] \{v['caption']\}" for v in visuals\par
    )\par
\par
    try:\par
        # ── LLM Answer ──────────────────────────────────────\par
        result = answer_question(\par
            question=req.question,\par
            transcript=full_text,\par
            visuals=visuals_text,\par
            language=language_display,\par
            model=req.model,\par
        )\par
\par
        # ── Clip Retrieval ───────────────────────────────────\par
        clip_start, clip_end = find_clip_timestamps(\par
            transcript_segments=segments,\par
            question=req.question,\par
            video_duration=duration,\par
        )\par
\par
        clip_label = f"\{_fmt_time(clip_start)\} – \{_fmt_time(clip_end)\}"\par
\par
        # Extract clip and save\par
        clip_filename = f"clip_\{req.session_id[:8]\}.mp4"\par
        clip_out_path = str(OUTPUT_DIR / clip_filename)\par
\par
        try:\par
            extract_clip(session["video_path"], clip_start, clip_end, clip_out_path)\par
            clip_url = f"/download/clip/\{clip_filename\}"\par
        except Exception:\par
            clip_url = None\par
\par
        return \{\par
            "status":   "success",\par
            "question": req.question,\par
            "answer":   result.get("answer", ""),\par
            "confidence": f"\{result.get('confidence', 'Medium')\} – \{result.get('confidence_reason', 'Based on transcript + visual frames')\}",\par
            "evidence": \{\par
                "transcript_excerpts": result.get("transcript_excerpts", []),\par
                "visual_captions":     result.get("visual_captions", []),\par
            \},\par
            "clip": \{\par
                "start":  clip_start,\par
                "end":    clip_end,\par
                "url":    clip_url,\par
                "label":  clip_label,\par
            \},\par
        \}\par
\par
    except Exception as e:\par
        raise HTTPException(status_code=500, detail=f"QA failed: \{str(e)\}")\par
\par
