        </div>\par
        <div class="evidence-section">\par
          <div class="evidence-title">👁️ Visual Captions</div>\par
          $\{result.evidence.visual_captions.map(c => `<div class="evidence-item" style="border-left-color:var(--accent-2)">$\{c\}</div>`).join('')\}\par
