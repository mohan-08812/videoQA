@app.get("/download/transcript/\{session_id\}")\par
def download_transcript(session_id: str):\par
    session = get_session(session_id)\par
    if not session:\par
        raise HTTPException(status_code=404, detail="Session not found.")\par
\par
    lines = session.get("transcript", [])\par
    text  = "\\n".join(f"[\{l['time']\}] \{l['speaker']\}: \{l['text']\}" for l in lines)\par
\par
    out_path = OUTPUT_DIR / f"transcript_\{session_id[:8]\}.txt"\par
    out_path.write_text(text, encoding="utf-8")\par
    return FileResponse(str(out_path), media_type="text/plain", filename="transcript.txt")\par
