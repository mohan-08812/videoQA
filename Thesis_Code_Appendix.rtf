function initTranscript() \{ \}\par
\par
function renderTranscriptTab() \{\par
  const tc = $('transcript-content');\par
  const lines = state.transcriptData || [];\par
\par
  tc.innerHTML = `\par
  <!--Toolbar -->\par
    <div class="glass transcript-toolbar">\par
      <div class="search-wrap">\par
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>\par
        <input type="text" class="search-input" id="transcript-search" placeholder="Search transcript…">\par
      </div>\par
      <label class="speaker-toggle">\par
        <div class="toggle-sw on" id="speaker-sw"></div>\par
        <span>Speaker Labels</span>\par
      </label>\par
      <button class="btn-secondary" onclick="copyTranscript()">📋 Copy</button>\par
      <button class="btn-secondary" onclick="downloadTranscript()">⬇️ Download</button>\par
    </div>\par
    <!--Body -->\par
  <div class="transcript-body" id="transcript-lines">\par
    $\{renderTranscriptLines(lines)\}\par
  </div>\par
`;\par
\par
  // Search\par
  $('transcript-search').addEventListener('input', e => \{\par
    highlightSearch(e.target.value.trim(), $('transcript-lines').querySelectorAll('.transcript-line'));\par
  \});\par
\par
  // Speaker toggle\par
  $('speaker-sw').addEventListener('click', function () \{\par
    state.speakerLabels = !state.speakerLabels;\par
    this.classList.toggle('on', state.speakerLabels);\par
    $('transcript-lines').querySelectorAll('.ts-speaker').forEach(el => \{\par
      el.style.display = state.speakerLabels ? '' : 'none';\par
    \});\par
  \});\par
\}\par
\par
function renderTranscriptLines(lines) \{\par
  if (!lines.length) return '<p style="color:var(--text-muted);padding:16px;">No transcript available.</p>';\par
  return lines.map(line => `\par
  <div class="transcript-line" data-text="$\{escapeHtml(line.text.toLowerCase())\}">\par
      <span class="ts-time">$\{line.time\}</span>\par
      <span class="ts-speaker">$\{line.speaker\}</span>\par
      <span class="ts-text">$\{escapeHtml(line.text)\}</span>\par
    </div>\par
  `).join('');\par
\}\par
\par
function highlightSearch(query, lines) \{\par
  lines.forEach(line => \{\par
    const textSpan = line.querySelector('.ts-text');\par
    const raw = state.transcriptData?.find(l => l.text.toLowerCase() === line.dataset.text)?.text || textSpan.textContent;\par
    if (!query) \{\par
      textSpan.innerHTML = escapeHtml(raw);\par
      line.classList.remove('highlight');\par
      return;\par
    \}\par
    const regex = new RegExp(`($\{escapeRegex(query)\})`, 'gi');\par
    const highlighted = escapeHtml(raw).replace(regex, '<mark>$1</mark>');\par
    textSpan.innerHTML = highlighted;\par
    line.classList.toggle('highlight', regex.test(raw));\par
  \});\par
\}\par
\par
function copyTranscript() \{\par
  const text = (state.transcriptData || []).map(l => `[$\{l.time\}] $\{l.speaker\}: $\{l.text\} `).join('\\n');\par
  copyText(text, 'Transcript copied!');\par
\}\par
function downloadTranscript() \{\par
  const text = (state.transcriptData || []).map(l => `[$\{l.time\}] $\{l.speaker\}: $\{l.text\} `).join('\\n');\par
  downloadText(text, 'transcript.txt');\par
\}\par
\par
// ═══════════════════════════════════════════\par
// MODAL\par
// ═══════════════════════════════════════════\par
function initModal() \{\par
  const modal = $('how-modal');\par
  $('how-btn').addEventListener('click', () => \{\par
    modal.classList.add('open');\par
    document.body.style.overflow = 'hidden';\par
  \});\par
  $('modal-close').addEventListener('click', closeModal);\par
  modal.addEventListener('click', e => \{ if (e.target === modal) closeModal(); \});\par
  document.addEventListener('keydown', e => \{ if (e.key === 'Escape') closeModal(); \});\par
\}\par
function closeModal() \{\par
  $('how-modal').classList.remove('open');\par
  document.body.style.overflow = '';\par
\}\par
\par
// ═══════════════════════════════════════════\par
// TOAST\par
// ═══════════════════════════════════════════\par
function showToast(msg, type = 'info') \{\par
  const container = $('toast-container');\par
  const toast = document.createElement('div');\par
  toast.className = `toast $\{type\} `;\par
  toast.innerHTML = `<span class="toast-icon"></span> <span>$\{msg\}</span>`;\par
  container.appendChild(toast);\par
  setTimeout(() => \{\par
    toast.classList.add('removing');\par
    setTimeout(() => toast.remove(), 300);\par
  \}, 3200);\par
\}\par
\par
// ═══════════════════════════════════════════\par
// ERROR CARD\par
// ═══════════════════════════════════════════\par
function showErrorCard(container, title, message) \{\par
  const card = document.createElement('div');\par
  card.className = 'error-card';\par
  card.innerHTML = `\par
  <span class="err-icon">⚠️</span>\par
    <div><h4>$\{title\}</h4><p>$\{message\}</p></div>\par
`;\par
  container.prepend(card);\par
\}\par
\par
// ═══════════════════════════════════════════\par
// SUMMARIZE TAB INIT ON TAB SWITCH\par
// ═══════════════════════════════════════════\par
function initSummarizeTabOnSwitch() \{\par
  if (state.phase !== 'ready') return;\par
  const sc = $('summarize-content');\par
  if (!sc.querySelector('.summarize-grid')) \{\par
    renderSummarizeUI();\par
  \}\par
\}\par
\par
// Override switchTab to trigger summarize render\par
const _originalSwitch = typeof switchTab !== 'undefined' ? null : null;\par
document.addEventListener('DOMContentLoaded', () => \{\par
  $$('.tab-btn').forEach(btn => \{\par
    btn.addEventListener('click', () => \{\par
      if (btn.dataset.tab === 'summarize') \{\par
        setTimeout(initSummarizeTabOnSwitch, 10);\par
      \}\par
    \});\par
  \});\par
\});\par
\par
// ═══════════════════════════════════════════\par
// UTILITY\par
// ═══════════════════════════════════════════\par
function copyText(text, msg = 'Copied!') \{\par
  navigator.clipboard.writeText(text).then(() => showToast(msg, 'success')).catch(() => \{\par
    // Fallback\par
    const ta = document.createElement('textarea');\par
    ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';\par
    document.body.appendChild(ta); ta.select();\par
    document.execCommand('copy'); ta.remove();\par
    showToast(msg, 'success');\par
  \});\par
\}\par
\par
function downloadText(text, filename) \{\par
  const url = URL.createObjectURL(new Blob([text], \{ type: 'text/plain' \}));\par
  const a = document.createElement('a');\par
  a.href = url; a.download = filename;\par
  document.body.appendChild(a); a.click();\par
  document.body.removeChild(a);\par
  URL.revokeObjectURL(url);\par
  showToast(`Downloaded $\{filename\} `, 'success');\par
\}\par
\par
function escapeHtml(str) \{\par
  return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');\par
\}\par
\par
function escapeRegex(str) \{\par
  return str.replace(/[.*+?^$\{\}()|[\\]\\\\]/g, '\\\\$&');\par
\}\par
\par\par}

{\b\f0\fs28 api.js\par}
{\f1\fs20 // api.js – API integration layer with mock fallback\par
// ─────────────────────────────────────────────────────────────────────────────\par
// MOCK_MODE: Set to `true`  → uses realistic demo data (no backend needed)\par
//            Set to `false` → calls the real FastAPI backend at API_BASE\par
// ─────────────────────────────────────────────────────────────────────────────\par
\par
const MOCK_MODE = false;             // ← Set to true to use demo data without backend\par
// For cloud deployment, use the current host. For local dev, use localhost:8000\par
const API_BASE = window.location.origin.includes("localhost") || window.location.origin.includes("127.0.0.1") \par
    ? "http://localhost:8000" \par
    : window.location.origin;\par
\par
let _sessionId = sessionStorage.getItem('vqa-session-id') || null;\par
\par
// ── Internal helpers ─────────────────────────────────────────\par
\par
async function apiFetch(path, options = \{\}) \{\par
    const res = await fetch(`$\{API_BASE\}$\{path\}`, \{\par
        headers: \{ "Content-Type": "application/json", ...options.headers \},\par
        ...options,\par
    \});\par
    if (!res.ok) \{\par
        const text = await res.text().catch(() => "Unknown error");\par
        throw new Error(`API $\{res.status\}: $\{text\}`);\par
    \}\par
    return res.json();\par
\}\par
\par
// ── processVideo ─────────────────────────────────────────────\par
/**\par
 * Upload and process a video.\par
 * @param \{File\}     file\par
 * @param \{string\}   videoUrl\par
 * @param \{string\}   language  – "English" | "Hindi" | "Telugu" | "Spanish" …\par
 * @param \{string\}   mode      – "fast" | "full"\par
 * @param \{string\}   startTime\par
 * @param \{string\}   endTime\par
 * @param \{string\}   manualFrames\par
 * @param \{Function\} onProgress – (label: string, pct: number) => void\par
 * @returns  \{ session_id, transcript, visuals, duration \}\par
 */\par
async function apiProcessVideo(file, videoUrl, language, mode, startTime, endTime, manualFrames, onProgress) \{\par
    if (MOCK_MODE) \{\par
        const steps = [\par
            \{ label: "Extracting audio", pct: 20 \},\par
            \{ label: "Transcribing speech", pct: 40 \},\par
            \{ label: "Understanding visuals", pct: 60 \},\par
            \{ label: "Generating answer model", pct: 80 \},\par
            \{ label: "Creating summaries", pct: 100 \},\par
        ];\par
        for (const step of steps) \{\par
            await mockDelay(700 + Math.random() * 500);\par
            if (onProgress) onProgress(step.label, step.pct);\par
        \}\par
        _sessionId = MOCK_DATA.processVideo.session_id;\par
        return MOCK_DATA.processVideo;\par
    \}\par
\par
    // ── Real backend ──────────────────────────────────────────\par
    if (onProgress) onProgress("Uploading video…", 5);\par
\par
    const form = new FormData();\par
    if (file) \{\par
        form.append("video", file);\par
    \}\par
    if (videoUrl) \{\par
        form.append("video_url", videoUrl);\par
    \}\par
    form.append("language", language);\par
    form.append("mode", mode);\par
    if (startTime) form.append("start_time", startTime);\par
    if (endTime) form.append("end_time", endTime);\par
    if (manualFrames) form.append("manual_frames", manualFrames);\par
\par
    if (onProgress) onProgress("Extracting audio", 15);\par
\par
    const res = await fetch(`$\{API_BASE\}/process_video`, \{\par
        method: "POST",\par
        body: form,\par
        // Note: do NOT set Content-Type here – browser sets multipart boundary\par
    \});\par
\par
    if (!res.ok) \{\par
        const err = await res.json().catch(() => (\{ detail: "Unknown error" \}));\par
        throw new Error(err.detail || `Server error $\{res.status\}`);\par
    \}\par
\par
    if (onProgress) onProgress("Finalising…", 95);\par
    const data = await res.json();\par
\par
    _sessionId = data.session_id;\par
    sessionStorage.setItem('vqa-session-id', _sessionId);\par
    if (onProgress) onProgress("Complete", 100);\par
    return data;\par
\}\par
\par
// ── askQuestion ───────────────────────────────────────────────\par
/**\par
 * Ask a question about the processed video.\par
 * @returns \{ answer, confidence, evidence, clip \}\par
 */\par
async function apiAsk(question, language = "English") \{\par
    if (MOCK_MODE) \{\par
        await mockDelay(1400);\par
        return MOCK_DATA.ask(question);\par
    \}\par
    return apiFetch("/ask", \{\par
        method: "POST",\par
        body: JSON.stringify(\{\par
            question,\par
            session_id: _sessionId,\par
            language,\par
        \}),\par
    \});\par
\}\par
\par
// ── summarizeVideo ────────────────────────────────────────────\par
/**\par
 * Summarize the video.\par
 * @param \{string\} length – "short" | "detailed" | "chapters"\par
 * @returns \{ short, detailed, chapters \}\par
 */\par
async function apiSummarizeVideo(length = "short") \{\par
    if (MOCK_MODE) \{\par
        await mockDelay(1200);\par
        return MOCK_DATA.summarizeVideo;\par
    \}\par
    return apiFetch("/summarize_video", \{\par
        method: "POST",\par
        body: JSON.stringify(\{ session_id: _sessionId, length \}),\par
    \});\par
\}\par
\par
// ── summarizeTranscript ───────────────────────────────────────\par
/**\par
 * Summarize the transcript into key points, action items, and keywords.\par
 * @returns \{ key_points, action_items, keywords \}\par
 */\par
async function apiSummarizeTranscript() \{\par
    if (MOCK_MODE) \{\par
        await mockDelay(1000);\par
        return MOCK_DATA.summarizeTranscript;\par
    \}\par
    return apiFetch("/summarize_transcript", \{\par
        method: "POST",\par
        body: JSON.stringify(\{ session_id: _sessionId \}),\par
    \});\par
\}\par
\par
// ── download helpers ──────────────────────────────────────────\par
/**\par
 * Returns the full download URL for a clip or transcript.\par
 * In mock mode, returns null (handled client-side).\par
 */\par
function apiClipUrl(filename) \{\par
    if (MOCK_MODE || !filename) return null;\par
    return `$\{API_BASE\}/download/clip/$\{filename\}`;\par
\}\par
\par
function apiTranscriptDownloadUrl() \{\par
    if (MOCK_MODE || !_sessionId) return null;\par
    return `$\{API_BASE\}/download/transcript/$\{_sessionId\}`;\par
\}\par
\par
// ── Session helpers ───────────────────────────────────────────\par
function getSessionId() \{ return _sessionId; \}\par
function clearSessionId() \{ _sessionId = null; sessionStorage.removeItem('vqa-session-id'); \}\par
\par\par}

