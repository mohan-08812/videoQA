// HISTORY SIDEBAR\par
// ═══════════════════════════════════════════\par
function initHistorySidebar() \{\par
  // Close sidebar on overlay click (mobile)\par
  const sb = $('sidebar');\par
  if (sb) \{\par
    sb.addEventListener('click', e => \{\par
      if (e.target === sb) sb.classList.remove('mobile-open');\par
    \});\par
  \}\par
  renderHistory();\par
\}\par
\par
function addToHistory(question, result) \{\par
  const item = \{\par
    id: Date.now(),\par
    question,\par
    result,\par
    time: new Date().toLocaleTimeString([], \{ hour: '2-digit', minute: '2-digit' \})\par
  \};\par
  state.history.unshift(item);\par
  renderHistory();\par
\}\par
\par
function renderHistory() \{\par
  const list = $('history-list');\par
  const count = $('history-count');\par
  if (!list) return;\par
  if (count) count.textContent = state.history.length;\par
\par
  if (state.history.length === 0) \{\par
    list.innerHTML = '<div class="history-empty">No questions yet.<br>Ask something to get started.</div>';\par
    return;\par
  \}\par
\par
  list.innerHTML = state.history.map((item, i) => `\par
  <div class="history-item $\{i === 0 && state.historyIndex === 0 ? 'active' : ''\}" onclick="restoreHistoryItem($\{item.id\})">\par
      <div class="hi-question">$\{escapeHtml(item.question)\}</div>\par
      <div class="hi-time">$\{item.time\}</div>\par
    </div>\par
  `).join('');\par
\}\par
\par
function restoreHistoryItem(id) \{\par
  const item = state.history.find(h => h.id === id);\par
  if (!item) return;\par
  if (state.phase !== 'ready') return;\par
\par
  const input = $('question-input');\par
  if (input) input.value = item.question;\par
\par
  const area = $('answer-area');\par
  if (area) renderAnswerCards(item.result, area);\par
\par
  // Mark active\par
  $$('.history-item').forEach(el => el.classList.remove('active'));\par
  // Sidebar close on mobile\par
  $('sidebar')?.classList.remove('mobile-open');\par
  switchTab('ask');\par
\}\par
