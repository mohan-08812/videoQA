@app.get("/download/clip/\{filename\}")\par
def download_clip(filename: str):\par
    path = OUTPUT_DIR / filename\par
    if not path.exists():\par
        raise HTTPException(status_code=404, detail="Clip file not found.")\par
    return FileResponse(\par
        str(path),\par
        media_type="video/mp4",\par
        filename=filename,\par
        headers=\{"Accept-Ranges": "bytes"\},\par
    )\par
