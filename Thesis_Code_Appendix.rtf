            Read Aloud\par
          </button>\par
          <button class="btn-secondary" onclick="copyText($\{safeAnswer\}, 'Answer copied!')">📋 Copy</button>\par
          <button class="btn-secondary" onclick="downloadText($\{safeAnswer\}, 'answer.txt')">⬇️ Download</button>\par
        </div>\par
      </div>\par
      <div class="answer-text">$\{answerHtml\}</div>\par
      <div class="confidence-badge">$\{result.confidence\}</div>\par
