def _lang_code(language: str) -> str | None:\par
    """Accept either full names ('English') or short ISO codes ('en')."""\par
    lang = language.strip()\par
    # Already a valid short code\par
    if lang.lower() in _VALID_SHORT_CODES:\par
        return lang.lower()\par
    # Full name mapping\par
    return _LANG_MAP.get(lang.lower())\par
