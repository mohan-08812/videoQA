// VOICE INPUT (MIC – SpeechRecognition API)\par
// ═══════════════════════════════════════════\par
let _recognition = null;\par
let _isListening = false;\par
\par
// Map ISO language codes to BCP-47 locales for SpeechRecognition\par
const LANG_TO_BCP47 = \{\par
  en: 'en-US', hi: 'hi-IN', te: 'te-IN', ta: 'ta-IN',\par
  kn: 'kn-IN', ml: 'ml-IN', mr: 'mr-IN', bn: 'bn-IN',\par
  pa: 'pa-IN', gu: 'gu-IN', ur: 'ur-PK',\par
  es: 'es-ES', fr: 'fr-FR', de: 'de-DE', zh: 'zh-CN',\par
  ar: 'ar-SA', ja: 'ja-JP', ko: 'ko-KR', pt: 'pt-BR',\par
  ru: 'ru-RU', it: 'it-IT',\par
\};\par
\par
function initVoiceInput() \{\par
  const micBtn = $('mic-btn');\par
  const status = $('voice-status');\par
  const statusTx = $('voice-status-text');\par
  const input = $('question-input');\par
\par
  const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;\par
  if (!SpeechRec) \{\par
    if (micBtn) \{ micBtn.classList.add('unavailable'); micBtn.title = 'Voice input not supported in this browser (use Chrome/Edge)'; \}\par
    return;\par
  \}\par
\par
  _recognition = new SpeechRec();\par
  _recognition.continuous = false;\par
  _recognition.interimResults = true;\par
\par
  _recognition.onstart = () => \{\par
    _isListening = true;\par
    micBtn.classList.add('listening');\par
    micBtn.innerHTML = '<svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M19 10v2a7 7 0 0 1-14 0v-2H3v2a9 9 0 0 0 8 8.94V23H9v2h6v-2h-2v-2.06A9 9 0 0 0 21 12v-2z"/></svg>';\par
    if (status) status.classList.add('show');\par
    if (statusTx) statusTx.textContent = 'Listening… speak your question';\par
  \};\par
\par
  _recognition.onresult = (e) => \{\par
    let interim = '', final = '';\par
    for (let i = e.resultIndex; i < e.results.length; i++) \{\par
      const t = e.results[i][0].transcript;\par
      if (e.results[i].isFinal) final += t; else interim += t;\par
    \}\par
    if (input) input.value = final || interim;\par
    if (statusTx) statusTx.textContent = interim ? `Hearing: "$\{interim\}"` : 'Listening…';\par
  \};\par
\par
  _recognition.onend = () => \{\par
    _isListening = false;\par
    micBtn.classList.remove('listening');\par
    micBtn.innerHTML = '<svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2H3v2a9 9 0 0 0 8 8.94V23H9v2h6v-2h-2v-2.06A9 9 0 0 0 21 12v-2z"/></svg>';\par
    if (status) status.classList.remove('show');\par
    if (input && input.value.trim()) showToast('Question captured! Press Ask to submit.', 'success');\par
  \};\par
\par
  _recognition.onerror = (e) => \{\par
    _isListening = false;\par
    micBtn.classList.remove('listening');\par
    if (status) status.classList.remove('show');\par
    const msg = e.error === 'not-allowed'\par
      ? 'Microphone access denied. Allow mic in browser settings.'\par
      : `Voice error: $\{e.error\}`;\par
    showToast(msg, 'error');\par
  \};\par
\par
  micBtn.addEventListener('click', () => \{\par
    if (_isListening) \{\par
      _recognition.stop();\par
      return;\par
    \}\par
    const langCode = $('language-select')?.value || 'en';\par
    _recognition.lang = LANG_TO_BCP47[langCode] || 'en-US';\par
    try \{ _recognition.start(); \}\par
    catch (err) \{ showToast('Could not start voice input: ' + err.message, 'error'); \}\par
  \});\par
\}\par
\par
// ═══════════════════════════════════════════\par
// TEXT-TO-SPEECH (SpeechSynthesis API)\par
// ═══════════════════════════════════════════\par
let _ttsUtterance = null;\par
let _ttsSpeaking = false;\par
\par
const LANG_TO_TTS_BCP47 = \{\par
  en: 'en-US', hi: 'hi-IN', te: 'te-IN', ta: 'ta-IN',\par
  kn: 'kn-IN', ml: 'ml-IN', mr: 'mr-IN', bn: 'bn-IN',\par
  pa: 'pa-IN', gu: 'gu-IN', ur: 'ur-PK',\par
  es: 'es-ES', fr: 'fr-FR', de: 'de-DE', zh: 'zh-CN',\par
  ar: 'ar-SA', ja: 'ja-JP', ko: 'ko-KR', pt: 'pt-BR',\par
  ru: 'ru-RU', it: 'it-IT',\par
\};\par
\par
function toggleReadAloud(text, btn) \{\par
  if (!window.speechSynthesis) \{\par
    showToast('Text-to-speech not supported in this browser.', 'error'); return;\par
  \}\par
\par
  if (_ttsSpeaking) \{\par
    window.speechSynthesis.cancel();\par
    _ttsSpeaking = false;\par
    if (btn) \{ btn.classList.remove('speaking'); btn.innerHTML = '<svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg> Read Aloud'; \}\par
    return;\par
  \}\par
\par
  // Strip markdown bold marks\par
  const cleanText = text.replace(/\\*\\*(.*?)\\*\\*/g, '$1');\par
  _ttsUtterance = new SpeechSynthesisUtterance(cleanText);\par
\par
  const langCode = $('language-select')?.value || 'en';\par
  _ttsUtterance.lang = LANG_TO_TTS_BCP47[langCode] || 'en-US';\par
  _ttsUtterance.rate = 0.95;\par
  _ttsUtterance.pitch = 1.0;\par
\par
  // Try to pick a voice matching the language\par
  const voices = window.speechSynthesis.getVoices();\par
  const match = voices.find(v => v.lang.startsWith(_ttsUtterance.lang.split('-')[0]));\par
  if (match) _ttsUtterance.voice = match;\par
\par
  _ttsUtterance.onstart = () => \{\par
    _ttsSpeaking = true;\par
    if (btn) \{ btn.classList.add('speaking'); btn.innerHTML = '<svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6zm8-14v14h4V5z"/></svg> Stop'; \}\par
  \};\par
  _ttsUtterance.onend = _ttsUtterance.onerror = () => \{\par
    _ttsSpeaking = false;\par
    if (btn) \{ btn.classList.remove('speaking'); btn.innerHTML = '<svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg> Read Aloud'; \}\par
  \};\par
\par
  window.speechSynthesis.speak(_ttsUtterance);\par
  showToast('Reading answer aloud…', 'info');\par
\}\par
\par
function toggleEvidence(el) \{\par
  const body = $('evidence-body');\par
  const arrow = el.querySelector('.toggle-arrow');\par
  if (body) body.classList.toggle('show');\par
  if (arrow) arrow.classList.toggle('open');\par
\}\par
\par
\par
