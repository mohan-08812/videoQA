{\b\f0\fs28 app.js\par}
{\f1\fs20 /* =========================================================\par
   app.js – VideoQA Core Application Logic\par
   ========================================================= */\par
\par
// ── App State ──────────────────────────────────────────────\par
const state = \{\par
  theme: 'dark',\par
  tab: 'ask',\par
  phase: 'idle',       // idle | uploading | processing | ready\par
  file: null,\par
  videoUrl: null,\par
  manualFrames: [],    // user selected frame timestamps\par
  sessionData: null,   // processVideo result\par
  currentAnswer: null,\par
  history: [],\par
  historyIndex: -1,\par
  speakerLabels: true,\par
  transcriptData: null,\par
  summarizeMode: 'short',\par
  transcriptSummarized: false,\par
  videoSummarized: false,\par
\};\par
\par
// ── DOM refs ───────────────────────────────────────────────\par
const $ = id => document.getElementById(id);\par
const $$ = sel => document.querySelectorAll(sel);\par
\par
// ── Boot ───────────────────────────────────────────────────\par
document.addEventListener('DOMContentLoaded', () => \{\par
  initTheme();\par
  initTabs();\par
  initUpload();\par
  initQA();\par
  initSummarize();\par
  initTranscript();\par
  initModal();\par
  initHistorySidebar();\par
  initHeaderActions();\par
  renderDemoState();\par
\});\par
\par
// ═══════════════════════════════════════════\par
// THEME\par
// ═══════════════════════════════════════════\par
function initTheme() \{\par
  const saved = localStorage.getItem('vqa-theme') || 'dark';\par
  setTheme(saved);\par
\}\par
\par
function setTheme(t) \{\par
  state.theme = t;\par
  document.documentElement.setAttribute('data-theme', t);\par
  const btn = $('theme-toggle');\par
  if (btn) btn.innerHTML = t === 'dark' ? '☀️' : '🌙';\par
  localStorage.setItem('vqa-theme', t);\par
\}\par
\par
// ═══════════════════════════════════════════\par
// TABS\par
// ═══════════════════════════════════════════\par
function initTabs() \{\par
  $$('.tab-btn').forEach(btn => \{\par
    btn.addEventListener('click', () => switchTab(btn.dataset.tab));\par
  \});\par
\}\par
\par
function switchTab(tab) \{\par
  state.tab = tab;\par
  $$('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));\par
  $$('.tab-panel').forEach(p => p.classList.toggle('active', p.id === `panel-$\{tab\}`));\par
\}\par
\par
// ═══════════════════════════════════════════\par
// HEADER ACTIONS\par
// ═══════════════════════════════════════════\par
function initHeaderActions() \{\par
  $('theme-toggle').addEventListener('click', () => setTheme(state.theme === 'dark' ? 'light' : 'dark'));\par
\par
  $('clear-btn').addEventListener('click', () => \{\par
    if (!confirm('Reset session and clear all data?')) return;\par
    resetSession();\par
  \});\par
\par
  // Mobile history drawer toggle\par
  const mobileBtn = $('history-mobile-btn');\par
  if (mobileBtn) \{\par
    mobileBtn.addEventListener('click', () => \{\par
      const sb = $('sidebar');\par
      if (sb) sb.classList.toggle('mobile-open');\par
    \});\par
  \}\par
\}\par
\par
function resetSession() \{\par
  state.phase = 'idle';\par
  state.file = null;\par
  state.videoUrl = null;\par
  state.manualFrames = [];\par
  state.sessionData = null;\par
  state.currentAnswer = null;\par
  state.history = [];\par
  state.transcriptData = null;\par
  state.videoSummarized = false;\par
  state.transcriptSummarized = false;\par
  clearSessionId(); // wipe persisted session_id from sessionStorage\par
\par
  // Reset upload\par
  $('drop-zone').classList.remove('file-selected');\par
  $('file-info').classList.remove('show');\par
  $('video-preview-wrap').classList.remove('show');\par
  const preview = $('video-preview');\par
  if (preview) \{ preview.src = ''; \}\par
  $('file-input').value = '';\par
\par
  // Hide progress\par
  $('progress-panel').classList.remove('show');\par
  updateProgressUI(0, '');\par
\par
  // Reset buttons\par
  $('process-btn').disabled = true;\par
\par
  // Clear results\par
  renderDemoState();\par
  clearSummarizeOutputs();\par
  clearTranscriptOutput();\par
\par
  // Clear history\par
  state.history = [];\par
  renderHistory();\par
\par
  showToast('Session cleared', 'info');\par
  switchTab('ask');\par
\}\par
\par
// ═══════════════════════════════════════════\par
// UPLOAD\par
// ═══════════════════════════════════════════\par
function initUpload() \{\par
  const dropZone = $('drop-zone');\par
  const fileInput = $('file-input');\par
  const processBtn = $('process-btn');\par
\par
  const addUrlBtn = $('add-url-btn');\par
  const urlInput = $('url-input');\par
  if (addUrlBtn) \{\par
    addUrlBtn.addEventListener('click', (e) => \{\par
      e.stopPropagation();\par
      const url = urlInput.value.trim();\par
      if (!url) \{ showToast('Please enter a valid URL', 'info'); return; \}\par
      handleUrlSelect(url);\par
    \});\par
  \}\par
\par
  // Click to open file picker\par
  dropZone.addEventListener('click', () => fileInput.click());\par
\par
  fileInput.addEventListener('change', e => \{\par
    const f = e.target.files[0];\par
    if (f) handleFileSelect(f);\par
  \});\par
\par
  // Drag & drop\par
  dropZone.addEventListener('dragover', e => \{ e.preventDefault(); dropZone.classList.add('drag-over'); \});\par
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));\par
  dropZone.addEventListener('drop', e => \{\par
    e.preventDefault();\par
    dropZone.classList.remove('drag-over');\par
    const f = e.dataTransfer.files[0];\par
    if (f) handleFileSelect(f);\par
  \});\par
\par
  // Remove file\par
  $('file-remove').addEventListener('click', e => \{\par
    e.stopPropagation();\par
    removeFile();\par
  \});\par
\par
  // Manual Frames\par
  $('add-frame-btn').addEventListener('click', () => \{\par
    const vp = $('video-preview');\par
    if (!vp) return;\par
    const t = Number(vp.currentTime.toFixed(2));\par
    if (!state.manualFrames.includes(t)) \{\par
      state.manualFrames.push(t);\par
      state.manualFrames.sort((a,b) => a - b);\par
      renderManualFrames();\par
    \}\par
  \});\par
\par
  // Process\par
  processBtn.addEventListener('click', processVideo);\par
\}\par
\par
function handleFileSelect(file) \{\par
  const allowed = ['video/mp4', 'video/quicktime', 'video/x-matroska', 'video/webm', 'video/avi'];\par
  if (!allowed.includes(file.type) && !file.name.match(/\\.(mp4|mov|mkv|webm|avi)$/i)) \{\par
    showToast('Unsupported file format. Use MP4, MOV, or MKV.', 'error');\par
    return;\par
  \}\par
  state.file = file;\par
  state.videoUrl = null;\par
  state.phase = 'uploading';\par
\par
  // Show file info\par
  $('file-name-display').textContent = file.name;\par
  $('file-detail-display').textContent = `$\{formatFileSize(file.size)\} · $\{file.type || 'video'\}`;\par
  $('file-info').classList.add('show');\par
  $('process-btn').disabled = false;\par
\par
  // Video preview\par
  const url = URL.createObjectURL(file);\par
  const vp = $('video-preview');\par
  vp.style.display = 'block';\par
  vp.src = url;\par
  vp.onloadedmetadata = () => \{\par
    const dur = formatDuration(vp.duration);\par
    $('file-detail-display').textContent = `$\{formatFileSize(file.size)\} · $\{dur\}`;\par
  \};\par
  $('video-preview-wrap').classList.add('show');\par
  $('manual-selection-tools').style.display = 'flex';\par
\par
  showToast(`"$\{file.name\}" selected`, 'success');\par
\}\par
\par
function handleUrlSelect(url) \{\par
  state.file = null;\par
  state.videoUrl = url;\par
  state.phase = 'uploading';\par
\par
  // Show file info\par
  $('file-name-display').textContent = url;\par
  $('file-detail-display').textContent = `URL Video`;\par
  $('file-info').classList.add('show');\par
  $('process-btn').disabled = false;\par
\par
  // Hide the <video> element because we can't preview all URLs uniformly,\par
  // but keep the wrapper around to show the manual tools if user wants to set timestamps.\par
  const vp = $('video-preview');\par
  vp.style.display = 'none';\par
  $('video-preview-wrap').classList.add('show');\par
  $('manual-selection-tools').style.display = 'flex';\par
\par
  showToast(`URL selected`, 'success');\par
\}\par
\par
function removeFile() \{\par
  state.file = null;\par
  state.videoUrl = null;\par
  state.manualFrames = [];\par
  state.phase = 'idle';\par
  $('file-info').classList.remove('show');\par
  $('video-preview-wrap').classList.remove('show');\par
  $('video-preview').style.display = 'block';\par
  $('manual-selection-tools').style.display = 'none';\par
  $('manual-start').value = '';\par
  $('manual-end').value = '';\par
  renderManualFrames();\par
  $('file-input').value = '';\par
  const urlInput = $('url-input');\par
  if(urlInput) urlInput.value = '';\par
  $('process-btn').disabled = true;\par
\}\par
\par
async function processVideo() \{\par
  if (!state.file && !state.videoUrl) return;\par
\par
  const language = $('language-select').value;\par
  const mode = document.querySelector('.mode-opt.active')?.dataset.mode || 'fast';\par
  const startTime = $('manual-start').value || '';\par
  const endTime = $('manual-end').value || '';\par
  const manFrames = state.manualFrames.join(',');\par
  const processBtn = $('process-btn');\par
\par
  processBtn.disabled = true;\par
  processBtn.innerHTML = '<span class="spinner"></span> Processing…';\par
  state.phase = 'processing';\par
\par
  $('progress-panel').classList.add('show');\par
\par
  const steps = [\par
    \{ label: 'Extracting audio', icon: '🔊' \},\par
    \{ label: 'Transcribing speech', icon: '📝' \},\par
    \{ label: 'Understanding visuals', icon: '👁️' \},\par
    \{ label: 'Generating answer model', icon: '🧠' \},\par
    \{ label: 'Creating summaries', icon: '✨' \},\par
  ];\par
  resetProgressSteps(steps);\par
\par
  try \{\par
    const data = await apiProcessVideo(state.file, state.videoUrl, language, mode, startTime, endTime, manFrames, (stepLabel, pct) => \{\par
      const idx = steps.findIndex(s => s.label === stepLabel);\par
      updateProgressUI(pct, stepLabel, idx, steps.length);\par
    \});\par
\par
    state.sessionData = data;\par
    state.transcriptData = data.transcript;\par
    state.phase = 'ready';\par
\par
    processBtn.innerHTML = '✅ Processing Complete';\par
    setTimeout(() => \{\par
      processBtn.innerHTML = '🔄 Re-process';\par
      processBtn.disabled = false;\par
    \}, 1500);\par
\par
    // Unlock tabs, render ready state\par
    enableResultTabs();\par
    renderReadyState();\par
    renderTranscriptTab();\par
    showToast('Video processed successfully!', 'success');\par
    switchTab('ask');\par
\par
  \} catch (err) \{\par
    state.phase = 'idle';\par
    processBtn.innerHTML = '⚡ Process Video';\par
    processBtn.disabled = false;\par
    showErrorCard($('ask-content'), 'Processing Failed', err.message || 'Could not process the video. Please try again.');\par
    showToast('Processing failed', 'error');\par
  \}\par
\}\par
\par
// ── Progress UI ────────────────────────────────────────────\par
function resetProgressSteps(steps) \{\par
  const container = $('progress-steps');\par
  container.innerHTML = '';\par
  steps.forEach((s, i) => \{\par
    const el = document.createElement('div');\par
    el.className = 'progress-step';\par
    el.id = `step-$\{i\}`;\par
    el.innerHTML = `\par
      <div class="step-icon" id="step-icon-$\{i\}">\par
        <span>$\{s.icon\}</span>\par
      </div>\par
      <span class="step-label" id="step-label-$\{i\}">$\{s.label\}</span>\par
    `;\par
    container.appendChild(el);\par
  \});\par
\}\par
\par
function updateProgressUI(pct, label, currentIdx = -1, total = 5) \{\par
  $('progress-bar').style.width = pct + '%';\par
  $('progress-pct').textContent = Math.round(pct) + '%';\par
  $('progress-status').textContent = label;\par
\par
  for (let i = 0; i < total; i++) \{\par
    const icon = $(`step-icon-$\{i\}`);\par
    const lbl = $(`step-label-$\{i\}`);\par
    if (!icon) continue;\par
    if (i < currentIdx) \{\par
      icon.className = 'step-icon done';\par
      icon.innerHTML = '';\par
      if (lbl) lbl.className = 'step-label';\par
    \} else if (i === currentIdx) \{\par
      icon.className = 'step-icon active';\par
      icon.innerHTML = '<div style="width:10px;height:10px;border:2px solid currentColor;border-radius:50%;"></div>';\par
      if (lbl) lbl.className = 'step-label active';\par
    \}\par
  \}\par
\}\par
\par
// ── Helpers ────────────────────────────────────────────────\par
function formatFileSize(bytes) \{\par
  if (bytes < 1024) return bytes + ' B';\par
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';\par
  return (bytes / (1024 * 1024)).toFixed(1) + ' MB';\par
\}\par
function formatDuration(secs) \{\par
  const m = Math.floor(secs / 60);\par
  const s = Math.floor(secs % 60);\par
  return `$\{m\}:$\{s.toString().padStart(2, '0')\}`;\par
\}\par
function formatDurationFixed(secs) \{\par
  const m = Math.floor(secs / 60);\par
  const s = (secs % 60).toFixed(1);\par
  return `$\{m\}:$\{s.padStart(4, '0')\}`;\par
\}\par
\par
function renderManualFrames() \{\par
  const list = $('manual-frames-list');\par
  if (!list) return;\par
  list.innerHTML = state.manualFrames.map(t => `\par
    <span class="fmt-badge" style="display:flex;align-items:center;gap:4px;padding-right:6px;">\par
      $\{formatDurationFixed(t)\}\par
      <button type="button" onclick="removeManualFrame($\{t\})" style="background:none;border:none;color:inherit;cursor:pointer;padding:0;font-size:10px;margin-left:4px;">✕</button>\par
    </span>\par
  `).join('');\par
\}\par
\par
window.removeManualFrame = function(t) \{\par
  state.manualFrames = state.manualFrames.filter(x => x !== t);\par
  renderManualFrames();\par
\};\par
\par
// ═══════════════════════════════════════════\par
// MODE TOGGLE\par
// ═══════════════════════════════════════════\par
document.addEventListener('DOMContentLoaded', () => \{\par
  $$('.mode-opt').forEach(btn => \{\par
    btn.addEventListener('click', () => \{\par
      $$('.mode-opt').forEach(b => b.classList.remove('active'));\par
      btn.classList.add('active');\par
    \});\par
  \});\par
\});\par
\par
// ═══════════════════════════════════════════\par
// DEMO / READY STATE\par
// ═══════════════════════════════════════════\par
function renderDemoState() \{\par
  $('ask-content').innerHTML = `\par
    <div class="demo-state glass">\par
      <span class="demo-icon">🎬</span>\par
      <h3>No video uploaded yet</h3>\par
      <p>Upload and process a video to start asking questions, viewing transcripts, and generating summaries.</p>\par
    </div>\par
  `;\par
  $('summarize-content').innerHTML = `\par
    <div class="demo-state glass">\par
      <span class="demo-icon">📊</span>\par
      <h3>Upload a video first</h3>\par
      <p>Process a video to generate intelligent summaries and key insights.</p>\par
    </div>\par
  `;\par
  $('transcript-content').innerHTML = `\par
    <div class="demo-state glass">\par
      <span class="demo-icon">📄</span>\par
      <h3>No transcript yet</h3>\par
      <p>Upload and process a video to view its full transcript with search and timestamps.</p>\par
    </div>\par
  `;\par
\}\par
\par
function enableResultTabs() \{\par
  // Nothing to hard-disable, but we render useful UI now\par
\}\par
\par
function renderReadyState() \{\par
  $('ask-content').innerHTML = `\par
    <div class="glass qa-input-card">\par
      <h2>💬 Ask a Question</h2>\par
      <div class="qa-input-wrap">\par
        <textarea id="question-input" class="question-area" placeholder="Type your question or click 🎤 to speak…" rows="4" style="padding-right:56px;"></textarea>\par
        <button class="btn-mic" id="mic-btn" title="Click to speak your question" aria-label="Voice input">\par
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2H3v2a9 9 0 0 0 8 8.94V23H9v2h6v-2h-2v-2.06A9 9 0 0 0 21 12v-2z"/></svg>\par
        </button>\par
      </div>\par
      <div class="voice-status" id="voice-status">\par
        <span class="voice-dot"></span>\par
        <span id="voice-status-text">Listening…</span>\par
      </div>\par
      <div class="qa-actions">\par
        <button class="btn-primary" id="ask-btn">\par
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m5 12 7-7 7 7M12 5v14"/></svg>\par
          Ask Question\par
        </button>\par
        <button class="btn-secondary" id="regen-btn" disabled>🔄 Regenerate</button>\par
      </div>\par
    </div>\par
    <div id="answer-area"></div>\par
  `;\par
\par
  $('ask-btn').addEventListener('click', handleAsk);\par
  $('question-input').addEventListener('keydown', e => \{\par
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') handleAsk();\par
  \});\par
  $('regen-btn').addEventListener('click', handleAsk);\par
\par
  initVoiceInput();\par
\}\par
