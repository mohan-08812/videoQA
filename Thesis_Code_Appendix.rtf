      <div class="clip-player-wrap">\par
        $\{result.clip.url\par
      ? `<video controls style="width:100%;border-radius:var(--radius-md);" src="$\{API_BASE\}$\{result.clip.url\}" preload="metadata"></video>`\par
      : `<div class="clip-placeholder">\par
              <span>🎬</span>\par
              <p>Clip preview available after processing with "QA + Clip Retrieval" mode</p>\par
