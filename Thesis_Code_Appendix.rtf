  box-shadow: 0 0 14px rgba(102, 126, 234, 0.35);\par
\}\par
\par
.btn-mic.listening \{\par
  background: rgba(248, 113, 113, 0.18);\par
  border-color: var(--error);\par
  color: var(--error);\par
  animation: micPulse 1.2s ease-in-out infinite;\par
\}\par
\par
@keyframes micPulse \{\par
\par
  0%,\par
  100% \{\par
    box-shadow: 0 0 0 0 rgba(248, 113, 113, 0.5);\par
  \}\par
\par
  50% \{\par
    box-shadow: 0 0 0 9px rgba(248, 113, 113, 0);\par
  \}\par
