/* ═══════════════════════════════════════════\par
   VOICE INPUT (MIC BUTTON)\par
═══════════════════════════════════════════ */\par
.qa-input-wrap \{\par
  position: relative;\par
  width: 100%;\par
\}\par
\par
.btn-mic \{\par
  position: absolute;\par
  right: 10px;\par
  bottom: 10px;\par
  width: 38px;\par
  height: 38px;\par
  border-radius: 50%;\par
  background: rgba(102, 126, 234, 0.15);\par
  border: 1.5px solid var(--border-accent);\par
  color: var(--accent-light);\par
  cursor: pointer;\par
  display: flex;\par
  align-items: center;\par
  justify-content: center;\par
  transition: all var(--transition);\par
  z-index: 2;\par
  font-size: 17px;\par
