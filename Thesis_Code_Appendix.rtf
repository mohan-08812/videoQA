{\b\f0\fs28 llm.py\par}
{\f1\fs20 """\par
llm.py – OpenRouter LLM integration\par
Supports multiple free models with automatic fallback on rate-limit (429) errors.\par
"""\par
\par
import os\par
import json\par
import requests\par
from dotenv import load_dotenv\par
\par
load_dotenv()\par
\par
OPENROUTER_API_KEY = os.getenv("OPENROUTER_API_KEY", "")\par
DEFAULT_MODEL = os.getenv("LLM_MODEL", "meta-llama/llama-3.3-70b-instruct:free")\par
OPENROUTER_URL = "https://openrouter.ai/api/v1/chat/completions"\par
\par
# ── Fallback chain: tried in order when a model is rate-limited or unavailable ──\par
FREE_MODEL_FALLBACKS = [\par
    "meta-llama/llama-3.3-70b-instruct:free",           # LLaMA 3.3 70B       – best quality\par
    "google/gemma-3-27b-it:free",                        # Gemma 3 27B         – Google\par
    "qwen/qwen-2.5-72b-instruct:free",                   # Qwen 2.5 72B        – Alibaba\par
    "mistralai/mistral-small-3.1-24b-instruct:free",     # Mistral Small 24B   – fast\par
    "nousresearch/hermes-3-llama-3.1-405b:free",         # Hermes 3 405B       – powerful\par
    "nvidia/nemotron-nano-9b-v2:free",                   # Nemotron 9B         – NVIDIA\par
    "deepseek/deepseek-r1-0528:free",                    # DeepSeek R1         – reasoning\par
    "microsoft/phi-4:free",                              # Phi-4               – Microsoft\par
    "openai/gpt-oss-20b:free",                           # GPT-OSS 20B         – OpenAI open\par
    "meta-llama/llama-3.2-3b-instruct:free",             # LLaMA 3.2 3B        – lightest\par
]\par
\par
# ── Available open-source models (all free on OpenRouter) ────\par
SUPPORTED_MODELS = \{\par
    "llama-3.3-70b":    FREE_MODEL_FALLBACKS[0],\par
    "gemma-3-27b":      FREE_MODEL_FALLBACKS[1],\par
    "qwen-2.5-72b":     FREE_MODEL_FALLBACKS[2],\par
    "mistral-small":    FREE_MODEL_FALLBACKS[3],\par
    "hermes-405b":      FREE_MODEL_FALLBACKS[4],\par
    "nemotron-9b":      FREE_MODEL_FALLBACKS[5],\par
    "deepseek-r1":      FREE_MODEL_FALLBACKS[6],\par
    "phi-4":            FREE_MODEL_FALLBACKS[7],\par
    "gpt-oss-20b":      FREE_MODEL_FALLBACKS[8],\par
    "llama-3.2-3b":     FREE_MODEL_FALLBACKS[9],\par
\}\par
\par
\par
# ── Single model call ────────────────────────────────────────\par
\par
def _call_single(messages: list[dict], model: str, temperature: float) -> str:\par
    """Call one specific model. Raises RateLimitError on 429, SkipModelError on 404, RuntimeError otherwise."""\par
    \par
    # -- KEYLESS FALLBACK --\par
    # If the user hasn't set an OpenRouter key yet, we silently and safely fall back \par
    # to pollinations.ai, a completely free, keyless wrapper for Llama 3 / OpenAI.\par
    if not OPENROUTER_API_KEY:\par
        url = "https://text.pollinations.ai/openai"\par
        headers = \{"Content-Type": "application/json"\}\par
        # Pollinations supports 'openai', 'llama', 'mistral', 'searchgpt'\par
        if "llama" in model.lower():\par
            req_model = "llama"\par
        elif "mistral" in model.lower() or "mixtral" in model.lower():\par
            req_model = "mistral"\par
        else:\par
            req_model = "openai" # GPT-4o fallback\par
    else:\par
        url = OPENROUTER_URL\par
        headers = \{\par
            "Authorization": f"Bearer \{OPENROUTER_API_KEY\}",\par
            "Content-Type":  "application/json",\par
            "HTTP-Referer":  "https://videoqa.local",\par
            "X-Title":       "VideoQA",\par
        \}\par
        req_model = model\par
\par
    resp = requests.post(\par
        url,\par
        headers=headers,\par
        json=\{\par
            "model":       req_model,\par
            "messages":    messages,\par
            "temperature": temperature,\par
            "max_tokens":  1024,\par
        \},\par
        timeout=60,\par
    )\par
    if resp.status_code == 429:\par
        raise RateLimitError(f"Rate-limited on \{model\}")\par
    if resp.status_code == 404:\par
        raise SkipModelError(f"Model not found: \{model\}")\par
    if resp.status_code in (401, 402, 403):\par
        raise AuthError(f"OpenRouter auth/payment error \{resp.status_code\} on \{model\}: \{resp.text[:200]\}")\par
    if resp.status_code != 200:\par
        raise SkipModelError(f"OpenRouter error \{resp.status_code\} on \{model\}: \{resp.text[:200]\}")\par
    data = resp.json()\par
    try:\par
        return data["choices"][0]["message"]["content"].strip()\par
    except (KeyError, IndexError) as e:\par
        raise RuntimeError(f"Unexpected OpenRouter response: \{data\}") from e\par
\par
\par
class AuthError(Exception):\par
    pass\par
\par
class RateLimitError(Exception):\par
    pass\par
\par
class SkipModelError(Exception):\par
    pass\par
\par
\par
# ── Core LLM call with fallback chain ───────────────────────\par
\par
def call_llm(messages: list[dict], model: str = DEFAULT_MODEL, temperature: float = 0.4) -> str:\par
    """\par
    Call OpenRouter with automatic fallback across FREE_MODEL_FALLBACKS.\par
    Skips models that return 429 (rate-limit) or 404 (not found) and tries the next.\par
    """\par
    # Start fallback logic\par
    # (Removed the fatal exception for missing API keys to allow the new Keyless feature)\par
\par
    # Requested model first, then remaining fallbacks (deduped)\par
    chain = [model] + [m for m in FREE_MODEL_FALLBACKS if m != model]\par
\par
    last_error = None\par
    for attempt_model in chain:\par
        try:\par
            print(f"[LLM] Trying: \{attempt_model\}")\par
            result = _call_single(messages, attempt_model, temperature)\par
            if attempt_model != model:\par
                print(f"[LLM] ✅ Used fallback: \{attempt_model\}")\par
            return result\par
        except (RateLimitError, SkipModelError) as e:\par
            print(f"[LLM] ⚠️  Skipping \{attempt_model\}: \{e\}")\par
            last_error = e\par
            continue\par
        except AuthError as e:\par
            print(f"[LLM] ⛔ Auth/Payment error on \{attempt_model\}: \{e\}. Skipping remaining OpenRouter models.")\par
            last_error = e\par
            break\par
        except Exception as e:\par
            print(f"[LLM] ❌ Unexpected error on \{attempt_model\}: \{e\}")\par
            last_error = e\par
            continue\par
\par
    print(f"[LLM] ⚠️ All \{len(chain)\} OpenRouter models exhausted (likely invalid API key). Using EMERGENCY free fallback...")\par
    \par
    # -- EMERGENCY KEYLESS FALLBACK --\par
    # If the user supplied a bad/revoked API key to Hugging Face, OpenRouter will fail every model with 401.\par
    # We catch that complete failure here and silently use Pollinations so the app never breaks for the user.\par
    try:\par
        fallback_models = ["openai", "llama"]\par
        for p_model in fallback_models:\par
            print(f"[LLM] Trying set keyless fallback with model '\{p_model\}'...")\par
            resp = requests.post(\par
                "https://text.pollinations.ai/openai",\par
                headers=\{"Content-Type": "application/json"\},\par
                json=\{\par
                    "model": p_model,\par
                    "messages": messages,\par
                    "temperature": temperature,\par
                    "max_tokens": 1024,\par
                \},\par
                timeout=60,\par
            )\par
            try:\par
                data = resp.json()\par
                if "choices" in data and len(data["choices"]) > 0:\par
                    return data["choices"][0]["message"]["content"].strip()\par
                elif "error" in data:\par
                    print(f"Pollinations error on \{p_model\}: \{data['error']\}. Trying next...")\par
                    fallback_e = f"Pollinations error: \{data['error']\}"\par
                    continue\par
                else:\par
                    fallback_e = f"Unexpected Pollinations response: \{data\}"\par
                    continue\par
            except json.JSONDecodeError:\par
                if resp.status_code == 200 and resp.text:\par
                    return resp.text.strip()\par
                fallback_e = f"Pollinations non-JSON response: \{resp.text\}"\par
                continue\par
        raise RuntimeError(fallback_e)\par
    except Exception as exc:\par
        raise RuntimeError(f"All \{len(chain)\} models exhausted. Last error: \{last_error\}. And free fallback failed: \{exc\}")\par
\par
\par
# ── QA ────────────────────────────────────────────────────────\par
\par
def answer_question(\par
    question: str,\par
    transcript: str,\par
    visuals: str,\par
    language: str = "English",\par
    model: str = DEFAULT_MODEL,\par
) -> dict:\par
    """\par
    Generate a detailed answer grounded in transcript + visual captions.\par
    Returns \{ answer, transcript_excerpts, visual_captions_used, confidence \}.\par
    """\par
    system_msg = (\par
        "You are an expert multimodal video analyst. "\par
        "You will be given a video transcript and visual frame descriptions. "\par
        "Answer the user's question thoroughly and accurately, citing specific parts of the transcript. "\par
        "If the answer is not clearly in the video, say so honestly."\par
    )\par
\par
    user_msg = f"""VIDEO TRANSCRIPT:\par
\{transcript\}\par
\par
VISUAL FRAME DESCRIPTIONS:\par
\{visuals\}\par
\par
QUESTION: \{question\}\par
\par
Instructions:\par
- Answer in \{language\}.\par
- Be detailed but concise (3-6 sentences).\par
- Bold key terms using **term** markdown.\par
- Extract 1-2 most relevant transcript sentences as evidence.\par
- Extract 1-2 most relevant visual captions as evidence.\par
- Rate your confidence as: High / Medium / Low.\par
\par
Format your response as valid JSON:\par
\{\{\par
  "answer": "...",\par
  "transcript_excerpts": ["...", "..."],\par
  "visual_captions": ["...", "..."],\par
  "confidence": "High|Medium|Low",\par
  "confidence_reason": "..."\par
\}\}"""\par
\par
    raw = call_llm(\par
        messages=[\par
            \{"role": "system", "content": system_msg\},\par
            \{"role": "user",   "content": user_msg\},\par
        ],\par
        model=model or DEFAULT_MODEL,\par
        temperature=0.3,\par
    )\par
\par
    # Parse JSON from response\par
    try:\par
        # Strip markdown code fences if present\par
        clean = raw.strip()\par
        if clean.startswith("```"):\par
            clean = "\\n".join(clean.split("\\n")[1:])\par
            if clean.endswith("```"):\par
                clean = clean[:-3]\par
        return json.loads(clean.strip())\par
    except json.JSONDecodeError:\par
        # Fallback: return raw text as answer\par
        return \{\par
            "answer": raw,\par
            "transcript_excerpts": [],\par
            "visual_captions": [],\par
            "confidence": "Medium",\par
            "confidence_reason": "Based on transcript + visual frames",\par
        \}\par
\par
\par
# ── Video Summarization ────────────────────────────────────────\par
\par
def summarize_video(\par
    transcript: str,\par
    visuals: str,\par
    length: str = "short",\par
    model: str = DEFAULT_MODEL,\par
) -> dict:\par
    """\par
    Summarize the video content.\par
    length: "short" | "detailed" | "chapters"\par
    Returns \{ short, detailed, chapters \}.\par
    """\par
    length_instructions = \{\par
        "short":    "Write a single concise paragraph (4-6 sentences) summarizing the video.",\par
        "detailed": "Write 5-8 bullet-point key takeaways from the video.",\par
        "chapters": "Identify 4-6 logical chapters/sections. For each provide a timestamp estimate and title.",\par
    \}\par
\par
    user_msg = f"""VIDEO TRANSCRIPT:\par
\{transcript\}\par
\par
VISUAL FRAME DESCRIPTIONS:\par
\{visuals\}\par
\par
\{length_instructions.get(length, length_instructions['short'])\}\par
\par
CRITICAL: The content inside the JSON strings/arrays MUST be strictly plain text. Do NOT include any HTML tags (like <div> or <class="...">), CSS classes, or markdown bullet points (like -, *).\par
\par
Format as JSON:\par
\{\{\par
  "short": "One paragraph summary...",\par
  "detailed": ["Point 1", "Point 2", ...],\par
  "chapters": [\{\{"time": "0:00", "title": "Introduction"\}\}, ...]\par
\}\}"""\par
\par
    raw = call_llm(\par
        messages=[\{"role": "user", "content": user_msg\}],\par
        model=model or DEFAULT_MODEL,\par
        temperature=0.4,\par
    )\par
\par
    try:\par
        clean = raw.strip()\par
        if clean.startswith("```"):\par
            clean = "\\n".join(clean.split("\\n")[1:]).rstrip("` \\n")\par
        return json.loads(clean.strip())\par
    except json.JSONDecodeError:\par
        return \{\par
            "short": raw[:400],\par
            "detailed": [raw],\par
            "chapters": [\{"time": "0:00", "title": "Full Video"\}],\par
        \}\par
\par
\par
# ── Transcript Summarization ────────────────────────────────────\par
\par
def summarize_transcript(transcript: str, model: str = DEFAULT_MODEL) -> dict:\par
    """\par
    Extract key points, action items, and keywords from the transcript.\par
    Returns \{ key_points, action_items, keywords \}.\par
    """\par
    user_msg = f"""VIDEO TRANSCRIPT:\par
\{transcript\}\par
\par
Extract the following from the transcript:\par
1. 5-7 key points (main ideas discussed)\par
2. 2-4 action items (things the viewer might do based on the content)\par
3. 10-15 important keywords or topics\par
\par
CRITICAL: The content inside the JSON arrays MUST be strictly plain text. Do NOT include any HTML tags (like <div> or <class="...">), CSS classes, or markdown bullet points (like -, *).\par
\par
Format as JSON:\par
\{\{\par
  "key_points": ["...", ...],\par
  "action_items": ["...", ...],\par
  "keywords": ["...", ...]\par
\}\}"""\par
\par
    raw = call_llm(\par
        messages=[\{"role": "user", "content": user_msg\}],\par
        model=model or DEFAULT_MODEL,\par
        temperature=0.3,\par
    )\par
\par
    try:\par
        clean = raw.strip()\par
        if clean.startswith("```"):\par
            clean = "\\n".join(clean.split("\\n")[1:]).rstrip("` \\n")\par
        return json.loads(clean.strip())\par
    except json.JSONDecodeError:\par
        return \{\par
            "key_points":   [raw[:200]],\par
            "action_items": [],\par
            "keywords":     [],\par
        \}\par
\par\par}

{\b\f0\fs28 models.py\par}
{\f1\fs20 """\par
models.py – Lazy-loaded AI model singletons\par
Loads Whisper and BLIP only once on first use to avoid repeated startup cost.\par
"""\par
\par
import os\par
import time\par
import torch\par
from dotenv import load_dotenv\par
\par
load_dotenv()\par
\par
WHISPER_MODEL_SIZE = os.getenv("WHISPER_MODEL", "base")   # base = fast, 140MB\par
_whisper = None\par
_blip_processor = None\par
_blip_model = None\par
_model_status = \{\par
    "whisper": "not_loaded",   # not_loaded | loading | ready | error\par
    "blip":    "not_loaded",\par
    "whisper_load_time": None,\par
    "blip_load_time": None,\par
\}\par
\par
# ── Whisper ─────────────────────────────────────────────────\par
class _FasterWhisperWrapper:\par
    """Wraps faster-whisper to match openai-whisper's transcribe() output format."""\par
    def __init__(self, model):\par
        self._model = model\par
\par
    def transcribe(self, audio_path, language=None, word_timestamps=False, **kwargs):\par
        segments_iter, info = self._model.transcribe(\par
            audio_path,\par
            language=language,\par
            word_timestamps=word_timestamps,\par
        )\par
        segments = []\par
        full_text_parts = []\par
        for seg in segments_iter:\par
            segments.append(\{\par
                "start": seg.start,\par
                "end":   seg.end,\par
                "text":  seg.text.strip(),\par
            \})\par
            full_text_parts.append(seg.text.strip())\par
        return \{\par
            "text": " ".join(full_text_parts),\par
            "segments": segments,\par
        \}\par
\par
def get_whisper():\par
    """Returns a loaded faster-whisper model wrapped in openai-whisper-compatible API."""\par
    global _whisper, _model_status\par
    if _whisper is None:\par
        _model_status["whisper"] = "loading"\par
        t0 = time.time()\par
        from faster_whisper import WhisperModel\par
        print(f"[VideoQA] Loading faster-whisper-\{WHISPER_MODEL_SIZE\}...")\par
        model = WhisperModel(WHISPER_MODEL_SIZE, device="cpu", compute_type="int8")\par
        _whisper = _FasterWhisperWrapper(model)\par
        elapsed = round(time.time() - t0, 1)\par
        _model_status["whisper"] = "ready"\par
        _model_status["whisper_load_time"] = elapsed\par
        print(f"[VideoQA] faster-whisper-\{WHISPER_MODEL_SIZE\} loaded in \{elapsed\}s ✓")\par
    return _whisper\par
\par
\par
# ── BLIP Vision Captioning ───────────────────────────────────\par
def get_blip():\par
    """Returns (processor, model) for BLIP-base (lazy singleton)."""\par
    global _blip_processor, _blip_model, _model_status\par
    if _blip_model is None:\par
        _model_status["blip"] = "loading"\par
        t0 = time.time()\par
        from transformers import BlipProcessor, BlipForConditionalGeneration\par
        # Use blip-base (~440MB) instead of blip-large (~900MB) — ~3× faster on CPU\par
        model_name = "Salesforce/blip-image-captioning-base"\par
        print(f"[VideoQA] Loading BLIP-base...")\par
        _blip_processor = BlipProcessor.from_pretrained(model_name)\par
        _blip_model = BlipForConditionalGeneration.from_pretrained(\par
            model_name,\par
            torch_dtype=torch.float16 if torch.cuda.is_available() else torch.float32\par
        )\par
        device = "cuda" if torch.cuda.is_available() else "cpu"\par
        _blip_model = _blip_model.to(device)\par
        _blip_model.eval()\par
        elapsed = round(time.time() - t0, 1)\par
        _model_status["blip"] = "ready"\par
        _model_status["blip_load_time"] = elapsed\par
        print(f"[VideoQA] BLIP-base loaded on \{device\} in \{elapsed\}s ✓")\par
    return _blip_processor, _blip_model\par
\par
\par
def get_model_status() -> dict:\par
    """Returns current load status for all models — used by /status endpoint."""\par
    device = "cuda" if torch.cuda.is_available() else "cpu"\par
    return \{\par
        "device": device,\par
        "whisper": \{\par
            "model":  WHISPER_MODEL_SIZE,\par
            "status": _model_status["whisper"],\par
            "load_time_sec": _model_status["whisper_load_time"],\par
        \},\par
        "blip": \{\par
            "model":  "blip-image-captioning-base",\par
            "status": _model_status["blip"],\par
            "load_time_sec": _model_status["blip_load_time"],\par
        \},\par
    \}\par
\par
\par
# ── Session Store ────────────────────────────────────────────\par
# Maps session_id → \{ transcript, visuals, video_path, transcript_lines \}\par
_sessions: dict = \{\}\par
\par
def get_session_store() -> dict:\par
    return _sessions\par
\par
def save_session(session_id: str, data: dict):\par
    _sessions[session_id] = data\par
\par
def get_session(session_id: str) -> dict | None:\par
    return _sessions.get(session_id)\par
\par
\par\par}

{\b\f0\fs28 video_utils.py\par}
{\f1\fs20 """\par
video_utils.py – Video processing helpers\par
Covers: audio extraction, smart keyframe sampling, BLIP captioning, clip extraction.\par
"""\par
\par
import os\par
import time\par
import subprocess\par
import cv2\par
import torch\par
import numpy as np\par
from PIL import Image\par
\par
# ── MoviePy import (for clip extraction only – v1.x and v2.x) ──\par
try:\par
    from moviepy.editor import VideoFileClip   # moviepy v1.x\par
except ImportError:\par
    from moviepy import VideoFileClip          # moviepy v2.x\par
\par
from models import get_blip\par
\par
MAX_FRAMES = int(os.getenv("MAX_FRAMES", "3"))\par
CLIP_DURATION = float(os.getenv("CLIP_DURATION", "30"))\par
\par
\par
# ── FFMPEG helper ────────────────────────────────────────────\par
\par
def _get_ffmpeg() -> str:\par
    """Return path to bundled ffmpeg binary (from imageio_ffmpeg/moviepy)."""\par
    try:\par
        import imageio_ffmpeg\par
        return imageio_ffmpeg.get_ffmpeg_exe()\par
    except Exception:\par
        return "ffmpeg"   # fall back to system PATH\par
\par
\par
# ── Audio ────────────────────────────────────────────────────\par
\par
def extract_audio(video_path: str, out_path: str = "audio.wav", start_sec: float = None, end_sec: float = None) -> str:\par
    """\par
    Extract 16kHz mono WAV audio from video using ffmpeg subprocess.\par
    Much faster and more reliable than MoviePy's write_audiofile on Windows.\par
    """\par
    t0 = time.time()\par
    print(f"[VideoQA] Extracting audio from \{os.path.basename(video_path)\}...")\par
    ffmpeg = _get_ffmpeg()\par
    cmd = [\par
        ffmpeg,\par
        "-y",                   # overwrite output\par
    ]\par
    if start_sec is not None:\par
        cmd.extend(["-ss", str(start_sec)])\par
    if end_sec is not None:\par
        duration = end_sec - (start_sec or 0.0)\par
        cmd.extend(["-t", str(duration)])\par
    cmd.extend([\par
        "-i", video_path,       # input video\par
        "-vn",                  # no video\par
        "-acodec", "pcm_s16le", # WAV format\par
        "-ar", "16000",         # 16kHz sample rate (required by Whisper)\par
        "-ac", "1",             # mono\par
        out_path,\par
    ])\par
    result = subprocess.run(\par
        cmd,\par
        stdout=subprocess.PIPE,\par
        stderr=subprocess.PIPE,\par
        timeout=300,            # 5 min timeout\par
    )\par
    if result.returncode != 0:\par
        err = result.stderr.decode("utf-8", errors="replace")[-500:]\par
        raise RuntimeError(f"ffmpeg audio extraction failed:\\n\{err\}")\par
    print(f"[VideoQA] Audio extracted in \{round(time.time()-t0,1)\}s -> \{out_path\}")\par
    return out_path\par
\par
\par
# ── Frame Extraction ─────────────────────────────────────────\par
\par
def _compute_frame_diff(prev: np.ndarray, curr: np.ndarray) -> float:\par
    """Mean absolute pixel difference between two frames (grayscale)."""\par
    p = cv2.cvtColor(prev, cv2.COLOR_BGR2GRAY).astype(float)\par
    c = cv2.cvtColor(curr, cv2.COLOR_BGR2GRAY).astype(float)\par
    return float(np.mean(np.abs(p - c)))\par
\par
\par
def extract_keyframes(video_path: str, n: int = MAX_FRAMES, start_sec: float = None, end_sec: float = None) -> list[str]:\par
    """\par
    Smart keyframe extraction:\par
    1. Sample frames uniformly across the video.\par
    2. Additionally pick frames with high scene-change score.\par
    Returns up to `n` unique frame file paths.\par
    """\par
    cap = cv2.VideoCapture(video_path)\par
    total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\par
    fps   = cap.get(cv2.CAP_PROP_FPS) or 25.0\par
\par
    start_frame = int(start_sec * fps) if start_sec is not None else 0\par
    end_frame = int(end_sec * fps) if end_sec is not None else total\par
\par
    saved_paths: list[str] = []\par
    os.makedirs("frames", exist_ok=True)\par
\par
    if total <= 0 or start_frame >= end_frame:\par
        cap.release()\par
        return saved_paths\par
\par
    if start_frame > 0:\par
        cap.set(cv2.CAP_PROP_POS_FRAMES, start_frame)\par
        \par
    frames_to_process = end_frame - start_frame\par
\par
    # Uniform sampling indices\par
    uniform_indices = set(\par
        start_frame + int(i * frames_to_process / n) for i in range(n)\par
    )\par
\par
    prev_frame = None\par
    frame_scores: list[tuple[float, int, np.ndarray]] = []\par
\par
    count = start_frame\par
    while cap.isOpened() and count < end_frame:\par
        ret, frame = cap.read()\par
        if not ret:\par
            break\par
\par
        if prev_frame is not None:\par
            score = _compute_frame_diff(prev_frame, frame)\par
            frame_scores.append((score, count, frame.copy()))\par
        elif count == start_frame:\par
            # Always keep first frame\par
            frame_scores.append((999.0, count, frame.copy()))\par
\par
        prev_frame = frame\par
        count += 1\par
\par
    cap.release()\par
\par
    if not frame_scores:\par
        return saved_paths\par
\par
    # Pick top-n frames by scene-change score, prioritising uniform coverage\par
    # Combine: add uniform indices to the selection weighted by score\par
    uniform_frames = []\par
    scene_frames = []\par
\par
    # Sort by score descending\par
    sorted_by_score = sorted(frame_scores, key=lambda x: x[0], reverse=True)\par
\par
    # Collect top scene-change frames\par
    selected_indices: set[int] = set()\par
    for score, idx, frm in sorted_by_score:\par
        if len(selected_indices) >= n:\par
            break\par
        # avoid picking frames too close together (< 1 second)\par
        too_close = any(abs(idx - s) < fps for s in selected_indices)\par
        if not too_close:\par
            selected_indices.add(idx)\par
\par
    # Pad with uniform indices if needed\par
    for ui in sorted(uniform_indices):\par
        if len(selected_indices) >= n:\par
            break\par
        selected_indices.add(ui)\par
\par
    # Write selected frames to disk (sorted by index = chronological)\par
    frame_dict = \{idx: frm for _, idx, frm in frame_scores\}\par
    for idx in sorted(selected_indices):\par
        if idx in frame_dict:\par
            path = f"frames/frame_\{idx:06d\}.jpg"\par
            cv2.imwrite(path, frame_dict[idx])\par
            saved_paths.append(path)\par
\par
    return saved_paths[:n]\par
\par
\par
def extract_specific_frames(video_path: str, timestamps: list[float]) -> list[str]:\par
    """\par
    Extract specific frames by timestamp.\par
    timestamps: list of floats in seconds.\par
    """\par
    cap = cv2.VideoCapture(video_path)\par
    fps = cap.get(cv2.CAP_PROP_FPS) or 25.0\par
    \par
    saved_paths = []\par
    os.makedirs("frames", exist_ok=True)\par
    \par
    for ts in sorted(set(timestamps)):\par
        frame_idx = int(ts * fps)\par
        cap.set(cv2.CAP_PROP_POS_FRAMES, frame_idx)\par
        ret, frame = cap.read()\par
        if ret:\par
            path = f"frames/frame_\{frame_idx:06d\}.jpg"\par
            cv2.imwrite(path, frame)\par
            saved_paths.append(path)\par
            \par
    cap.release()\par
    return saved_paths\par
\par
\par
# ── BLIP Captioning ──────────────────────────────────────────\par
\par
def caption_frames(frame_paths: list[str]) -> list[dict]:\par
    """\par
    Generate captions for each frame using BLIP-base.\par
    Returns list of \{ path, caption, frame_index \}.\par
    """\par
    print(f"[VideoQA] Captioning \{len(frame_paths)\} frame(s) with BLIP...")\par
    t_total = time.time()\par
    processor, model = get_blip()\par
    device = next(model.parameters()).device\par
    results = []\par
\par
    for i, path in enumerate(frame_paths):\par
        t0 = time.time()\par
        try:\par
            image = Image.open(path).convert("RGB")\par
            inputs = processor(image, return_tensors="pt").to(device)\par
\par
            with torch.no_grad():\par
                out = model.generate(\par
                    **inputs,\par
                    max_new_tokens=60,\par
                    num_beams=4,\par
                )\par
\par
            caption = processor.decode(out[0], skip_special_tokens=True)\par
            frame_idx = int(os.path.basename(path).replace("frame_", "").replace(".jpg", ""))\par
            results.append(\{\par
                "path": path,\par
                "caption": caption,\par
                "frame_index": frame_idx,\par
            \})\par
            print(f"[VideoQA]   Frame \{i+1\}/\{len(frame_paths)\} captioned in \{round(time.time()-t0,1)\}s: \{caption[:60]\}")\par
        except Exception as e:\par
            print(f"[VideoQA]   Frame \{i+1\} failed: \{e\}")\par
            results.append(\{"path": path, "caption": "Frame could not be captioned.", "frame_index": 0\})\par
\par
    print(f"[VideoQA] All frames captioned in \{round(time.time()-t_total,1)\}s")\par
    return results\par
\par
\par
# ── Clip Extraction ──────────────────────────────────────────\par
\par
def extract_clip(\par
    video_path: str,\par
    start_sec: float,\par
    end_sec: float,\par
    out_path: str = "relevant_clip.mp4"\par
) -> str:\par
    """\par
    Extract a sub-clip using ffmpeg subprocess.\par
    Much faster and more reliable than MoviePy on Windows.\par
    """\par
    t0 = time.time()\par
    duration_sec = max(1.0, end_sec - start_sec)\par
    start_sec = max(0.0, start_sec)\par
    print(f"[VideoQA] Extracting clip \{start_sec:.1f\}s -> \{end_sec:.1f\}s...")\par
    ffmpeg = _get_ffmpeg()\par
    cmd = [\par
        ffmpeg,\par
        "-y",\par
        "-ss", str(start_sec),       # seek to start (fast seek before -i)\par
        "-i", video_path,\par
        "-t", str(duration_sec),      # duration\par
        "-c:v", "libx264",\par
        "-c:a", "aac",\par
        "-movflags", "+faststart",    # web-compatible MP4\par
        out_path,\par
    ]\par
    result = subprocess.run(\par
        cmd,\par
        stdout=subprocess.PIPE,\par
        stderr=subprocess.PIPE,\par
        timeout=120,\par
    )\par
    if result.returncode != 0:\par
        err = result.stderr.decode("utf-8", errors="replace")[-300:]\par
        raise RuntimeError(f"ffmpeg clip extraction failed:\\n\{err\}")\par
    print(f"[VideoQA] Clip extracted in \{round(time.time()-t0,1)\}s -> \{out_path\}")\par
    return out_path\par
\par
\par
# ── Transcript → Timestamp Mapping ───────────────────────────\par
\par
def find_clip_timestamps(\par
    transcript_segments: list[dict],\par
    question: str,\par
    video_duration: float,\par
    clip_duration: float = CLIP_DURATION,\par
) -> tuple[float, float]:\par
    """\par
    Find the most relevant clip for a question.\par
    Uses simple keyword overlap over Whisper word-level segments.\par
    Falls back to 1/3 into the video if nothing found.\par
\par
    transcript_segments: list of \{ start, end, text \} dicts from Whisper.\par
    Returns (start_sec, end_sec).\par
    """\par
    if not transcript_segments:\par
        start = video_duration / 3\par
        return start, min(video_duration, start + clip_duration)\par
\par
    q_words = set(question.lower().split())\par
    best_score = -1\par
    best_start = 0.0\par
\par
    for seg in transcript_segments:\par
        seg_words = set(seg.get("text", "").lower().split())\par
        overlap = len(q_words & seg_words)\par
        if overlap > best_score:\par
            best_score = overlap\par
            best_start = seg.get("start", 0.0)\par
\par
    end = min(video_duration, best_start + clip_duration)\par
    return best_start, end\par
\par\par}

{\b\f0\fs28 Dockerfile\par}
{\f1\fs20 # Use Python 3.10 slim image suitable for ML\par
FROM python:3.10-slim\par
\par
# Install system dependencies required for OpenCV and ffmpeg\par
RUN apt-get update && apt-get install -y \\\par
    ffmpeg \\\par
    libsm6 \\\par
    libxext6 \\\par
    libgl1 \\\par
    && rm -rf /var/lib/apt/lists/*\par
\par
# Set up a non-root user for Hugging Face Spaces compatibility\par
RUN useradd -m -u 1000 user\par
USER user\par
ENV PATH="/home/user/.local/bin:$PATH"\par
\par
# Upgrade pip and install an older setuptools (v70+ removed pkg_resources which breaks openai-whisper)\par
RUN pip install --no-cache-dir --upgrade pip\par
RUN pip install --no-cache-dir "setuptools<70.0.0" wheel\par
\par
# Set early environment variables\par
ENV HOST=0.0.0.0\par
ENV PORT=7860\par
\par
# Set working directory\par
WORKDIR /home/user/app\par
\par
# Copy the backend requirements first for better caching\par
COPY --chown=user backend/requirements.txt ./backend/\par
\par
# IMPORTANT: Install CPU-only PyTorch. \par
# The default PyTorch library is a massive 2.5GB and often crashes the free Hugging Face builder. The CPU version is ~200MB!\par
RUN pip install --no-cache-dir torch==2.2.2 torchvision==0.17.2 --index-url https://download.pytorch.org/whl/cpu\par
\par
# Install the rest (using --no-build-isolation so it uses our downgraded setuptools instead of fetching the latest broken one)\par
RUN pip install --no-cache-dir --no-build-isolation -r backend/requirements.txt\par
\par
# Create necessary directories\par
RUN mkdir -p /home/user/app/backend/uploads /home/user/app/backend/outputs /home/user/app/backend/frames\par
\par
# Copy the rest of the application\par
COPY --chown=user . .\par
\par
# Expose port (7860 is default for Hugging Face Spaces Docker)\par
EXPOSE 7860\par
\par
# Change to the backend directory and run Uvicorn\par
WORKDIR /home/user/app/backend\par
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7860"]\par
\par\par}

